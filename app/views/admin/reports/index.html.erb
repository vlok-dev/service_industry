<p><%= link_to "Back to Admin Dashboard", admin_root_path %></p>

<h1>Reports & Suggestions</h1>

<table>
  <thead>
    <tr>
      <th>Date</th>
      <th>Type</th>
      <th>Title</th>
      <th>Submitted by</th>
      <th>Role</th>
      <th>Status</th>
      <th>Details</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @reports.each do |report| %>
      <tr>
        <td><%= report.created_at.in_time_zone('Africa/Johannesburg').strftime('%d %b %Y') %></td>
        <td><span class="badge badge-<%= report.bug? ? 'pending' : 'scheduled' %>"><%= report.category.humanize %></span></td>
        <td><%= report.title %></td>
        <td><%= report.user&.name || "—" %></td>
        <td><%= report.role&.humanize || "—" %></td>
        <td><%= report.status.humanize %></td>
        <td><%= report.description.to_s.truncate(500) %></td>
        <td><%= button_to "Delete", admin_report_path(report), method: :delete, data: { confirm: "Delete this report?" }, class: "btn btn-danger btn-sm" %></td>
      </tr>
    <% end %>
  </tbody>
</table>
