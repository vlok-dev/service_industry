<p><%= link_to "Back to Admin Dashboard", admin_root_path %></p>

<h1>People</h1>

<p>
  Each person can hold more than one role. Every role is a separate login with
  its own email and password, and each one shows that role's dashboard.
</p>

<%= form_with url: admin_users_path, method: :get, local: true do |f| %>
  <div style="margin-bottom: 1rem;">
    <%= f.text_field :q, value: @search_query, placeholder: "Search by name, email or phone" %>
    <%= f.submit "Search", class: "btn" %>
  </div>
<% end %>

<p><%= link_to "Add New Person", new_admin_user_path, class: "btn" %></p>

<table>
  <thead>
    <tr>
      <th>Person</th>
      <th>Profiles / Roles</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @people.each do |person| %>
      <tr>
        <td>
          <strong><%= person.name %></strong><br>
          <%= person.phone_number.presence || "N/A" %>
        </td>
        <td>
          <table style="width: 100%;">
            <thead>
              <tr>
                <th>Role</th>
                <th>Login Email</th>
                <th>Phone</th>
                <th>Last Login</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% person.profiles.order(:id).each do |profile| %>
                <tr>
                  <td>
                    <%= profile.role&.humanize || "N/A" %>
                    <% if profile == current_user %><span class="badge">(you)</span><% end %>
                  </td>
                  <td><%= profile.email || "No login email" %></td>
                  <td><%= profile.phone_number || "N/A" %></td>
                  <td><%= profile.last_logged_in_at&.in_time_zone('Africa/Johannesburg') || "N/A" %></td>
                  <td>
                    <%= link_to "Edit", edit_admin_user_path(profile) %>
                    <%= button_to "Delete", admin_user_path(profile), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-danger", style: "display: inline; padding: 0.25rem 0.5rem; font-size: 0.875rem;" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </td>
        <td>
          <%= link_to "Add Role", new_admin_user_path(person_id: person.id) %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
