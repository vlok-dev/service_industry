<%= form_with model: @client, local: true do |f| %>
  <% if @client.errors.any? %>
    <div class="alert">
      <h2><%= pluralize(@client.errors.count, "error") %> prohibited this client from being saved:</h2>
      <ul>
        <% @client.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :customer_code, "Customer Code" %>
    <%= f.text_field :customer_code, placeholder: "e.g. CUS-001" %>
  </div>

  <div class="field">
    <%= f.label :first_name, "Customer Name" %>
    <%= f.text_field :first_name, placeholder: "First name (if individual)" %>
  </div>

  <div class="field">
    <%= f.label :last_name, "Surname" %>
    <%= f.text_field :last_name, placeholder: "Last name (if individual)" %>
  </div>

  <div class="field">
    <%= f.label :company, "Company" %>
    <%= f.text_field :company, placeholder: "Company name (if business)" %>
    <p class="form-hint">If this is a company, provide the company name. Otherwise use customer name fields above.</p>
  </div>

  <div class="field">
    <%= f.label :contact_person, "Primary Contact" %>
    <%= f.text_field :contact_person, placeholder: "Person to contact" %>
    <p class="form-hint">Name of the primary contact person for this client.</p>
  </div>

  <div class="field">
    <%= f.label :email, "Primary Contact Email" %>
    <%= f.email_field :email, placeholder: "contact@company.com" %>
  </div>

  <div class="field">
    <%= f.label :primary_contact_mobile, "Primary Contact Mobile" %>
    <%= f.text_field :primary_contact_mobile, placeholder: "+27 11 123 4567" %>
  </div>

  <div class="field">
    <%= f.label :delivery_address, "Primary Delivery Address" %>
    <%= f.text_area :delivery_address, rows: 2 %>
  </div>

  <div class="field">
    <%= f.label :postal_address, "Primary Postal Address" %>
    <%= f.text_area :postal_address, rows: 2 %>
    <p class="form-hint">Leave blank if same as delivery address.</p>
  </div>

  <div class="field">
    <h3 style="margin-bottom: 0.5rem;">Addresses</h3>
    <p class="form-hint" style="margin-top: 0;">Add additional addresses for this client. You can pick one when creating a job.</p>
    <div id="client_addresses">
      <%= f.fields_for :addresses do |address_form| %>
        <% address_label = address_form.object&.label.presence || "Delivery" %>
        <% address_kind = address_label.downcase == "postal" ? "postal" : "delivery" %>
        <div class="address-row address-row--<%= address_kind %>">
          <div class="address-row-head">
            <span class="address-label-badge address-label-badge--<%= address_kind %>">
              <%= address_label %>
            </span>
            <% if address_form.object.persisted? %>
              <%= address_form.hidden_field :_destroy, class: "address-destroy" %>
              <button type="button" class="btn btn-sm btn-danger remove-address">Remove</button>
            <% else %>
              <button type="button" class="btn btn-sm btn-secondary remove-address">Remove</button>
            <% end %>
          </div>
          <div class="address-row-grid">
            <div>
              <%= address_form.label :label, style: "font-size: 0.75rem; font-weight: 600;" %>
              <%= address_form.select :label, ["Delivery", "Postal"], { include_blank: false }, { class: "address-label-select" } %>
            </div>
            <div>
              <%= address_form.label :address, style: "font-size: 0.75rem; font-weight: 600;" %>
              <%= address_form.text_area :address, rows: 2, class: "address-input" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <button type="button" id="add-address" class="btn btn-sm" style="margin-top: 0.5rem;">Add Address</button>
  </div>

  <%= f.submit class: "btn" %>
<% end %>

<script>
  var addressTemplate = `
    <div class="address-row address-row--delivery">
      <div class="address-row-head">
        <span class="address-label-badge address-label-badge--delivery">Delivery</span>
        <button type="button" class="btn btn-sm btn-secondary remove-address">Remove</button>
      </div>
      <div class="address-row-grid">
        <div>
          <label style="font-size: 0.75rem; font-weight: 600;">Label</label>
          <select name="client[addresses_attributes][NEW_INDEX][label]" class="address-label-select">
            <option value="Delivery">Delivery</option>
            <option value="Postal">Postal</option>
          </select>
        </div>
        <div>
          <label style="font-size: 0.75rem; font-weight: 600;">Address</label>
          <textarea name="client[addresses_attributes][NEW_INDEX][address]" rows="2" class="address-input"></textarea>
        </div>
      </div>
    </div>
  `;

  function paintAddressRow(row) {
    if (!row) return;
    var isDelivery = row.querySelector('.address-label-select')?.value === "Delivery";
    row.classList.toggle("address-row--delivery", isDelivery);
    row.classList.toggle("address-row--postal", !isDelivery);
    var badge = row.querySelector('.address-label-badge');
    if (badge) {
      badge.classList.toggle("address-label-badge--delivery", isDelivery);
      badge.classList.toggle("address-label-badge--postal", !isDelivery);
    }
  }

  document.addEventListener('change', function(e) {
    if (!e.target || !e.target.classList.contains('address-label-select')) return;
    var row = e.target.closest('.address-row');
    var badge = row?.querySelector('.address-label-badge');
    if (badge) badge.textContent = e.target.value;
    paintAddressRow(row);
  });

  function nextAddressIndex() {
    var container = document.getElementById('client_addresses');
    var used = new Set();
    container.querySelectorAll('textarea[name*="[address]"]').forEach(function(el) {
      var m = (el.name || '').match(/\[(\d+)\]/);
      if (m) used.add(parseInt(m[1], 10));
    });
    var i = 0;
    while (used.has(i)) i++;
    return i;
  }

  document.getElementById('add-address')?.addEventListener('click', function(e) {
    e.preventDefault();
    var container = document.getElementById('client_addresses');
    var row = document.createElement('div');
    row.innerHTML = addressTemplate.replace(/NEW_INDEX/g, nextAddressIndex());
    var addressRow = row.firstElementChild;
    container.appendChild(addressRow);
    addressRow.querySelector('.remove-address').addEventListener('click', function() {
      addressRow.remove();
    });
  });

  document.querySelectorAll('.remove-address').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      var row = btn.closest('.address-row');
      var destroyInput = row?.querySelector('.address-destroy');
      if (destroyInput) {
        destroyInput.value = '1';
        row.style.display = 'none';
      } else {
        row?.remove();
      }
    });
  });
</script>
