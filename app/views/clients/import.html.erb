<p><%= link_to "Back to Clients", clients_path, class: "btn" %></p>

<h1>Import Clients from CSV</h1>

<div style="background: #f9fafb; padding: 1rem; margin-bottom: 1rem; border-radius: 4px; border: 1px solid var(--border);">
  <p><strong>CSV Format:</strong></p>
  <p><code>Customer Code,Customer Name,Primary Contact,Primary Contact Email,Primary Contact Mobile,Primary Delivery Address,Primary Postal Address</code></p>
  <ul>
    <li><strong>Customer Code</strong> — Optional unique identifier (e.g. CUS-001)</li>
    <li><strong>Customer Name</strong> — Company name (required)</li>
    <li><strong>Primary Contact</strong> — Name of the contact person</li>
    <li><strong>Primary Contact Email</strong> — Contact email (optional)</li>
    <li><strong>Primary Contact Mobile</strong> — Contact phone number (optional)</li>
    <li><strong>Primary Delivery Address</strong> — Full delivery address</li>
    <li><strong>Primary Postal Address</strong> — Postal address (optional)</li>
  </ul>
  <p>Example:</p>
  <pre style="background: white; padding: 0.5rem; border-radius: 4px; border: 1px solid var(--border); overflow-x: auto;">
Customer Code,Customer Name,Primary Contact,Primary Contact Email,Primary Contact Mobile,Primary Delivery Address,Primary Postal Address
CUS-001,Acme Plumbing,John Smith,john@acme.com,011 234 5678,"123 Main St, Johannesburg",
CUS-002,Plumber Pro,Jane Doe,jane@plumberpro.com,011 987 6543,"456 Business Ave, Sandton","P.O. Box 123, Sandton"
  </pre>
</div>

<%= form_with url: import_create_clients_path, method: :post, local: true, enctype: "multipart/form-data" do |f| %>
  <div style="margin-bottom: 1rem;">
    <%= f.label :file, "CSV File" %><br>
    <%= f.file_field :file, accept: ".csv,text/csv", required: true %>
  </div>
  <%= f.submit "Import Clients", class: "btn btn-success" %>
<% end %>
