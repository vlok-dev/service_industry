<p><%= link_to "Back to Clients", clients_path, class: "btn" %></p>

<h1><%= @client.name %></h1>

<div style="background: #f9fafb; padding: 1.5rem; margin-bottom: 1.5rem; border-radius: var(--radius); border: 1px solid var(--border-light);">
  <p><strong>Customer Code:</strong> <%= @client.customer_code || "—" %></p>
  <p><strong>Customer Name:</strong> <%= @client.company.present? ? @client.company : [ @client.first_name, @client.last_name ].reject(&:blank?).join(" ") %></p>
  <p><strong>Primary Contact:</strong> <%= @client.contact_person || "—" %></p>
  <p><strong>Primary Contact Email:</strong> <%= @client.email || "—" %></p>
  <p><strong>Primary Contact Mobile:</strong> <%= @client.primary_contact_mobile || "—" %></p>
  <p><strong>Primary Delivery Address:</strong> <%= simple_format(@client.delivery_address) if @client.delivery_address.present? %></p>
  <p><strong>Primary Postal Address:</strong> <%= simple_format(@client.postal_address) if @client.postal_address.present? %></p>
</div>

<% if @client.addresses.present? %>
    <div style="margin-bottom: 1.5rem;">
      <div class="section-title">Addresses</div>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; margin-top: 1rem;">
        <% @client.addresses.order(id: :asc).each do |address| %>
          <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; background: var(--surface); box-shadow: var(--shadow);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
              <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; padding: 0.15rem 0.5rem; border-radius: 4px; color: <%= address.label == "Delivery" ? "white" : "#1b2c65" %>; background: <%= address.label == "Delivery" ? "#1b2c65" : "#b2d33e" %>;">
                <%= address.label %>
              </span>
            </div>
            <div style="font-size: 0.9rem; color: var(--text); white-space: pre-wrap;"><%= address.address %></div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

<p>
  <%= link_to "Edit", edit_client_path(@client), class: "btn" %>
  <%= button_to "Delete", @client, method: :delete, data: { confirm: "Delete this client?" }, class: "btn btn-danger", style: "display: inline;" %>
</p>
