<p><%= link_to "Back to Clients", clients_path, class: "btn" %></p>

<h1><%= @client.name %></h1>

<div style="background: #f9fafb; padding: 1rem; margin-bottom: 1rem; border-radius: 4px;">
  <p><strong>Name:</strong> <%= @client.first_name || "—" %></p>
  <p><strong>Surname:</strong> <%= @client.last_name || "—" %></p>
  <p><strong>Company:</strong> <%= @client.company || "—" %></p>
  <p><strong>Contact Number:</strong> <%= @client.phone_number || "—" %></p>
  <p><strong>Email Address:</strong> <%= @client.email || "—" %></p>
  <p><strong>Address:</strong> <%= simple_format(@client.address) if @client.address.present? %></p>
</div>

<p>
  <%= link_to "Edit", edit_client_path(@client), class: "btn" %>
  <%= button_to "Delete", @client, method: :delete, data: { confirm: "Delete this client?" }, class: "btn btn-danger", style: "display: inline;" %>
</p>
