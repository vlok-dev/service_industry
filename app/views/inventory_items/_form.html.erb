<%= form_with model: @inventory_item, local: true do |f| %>
  <% if @inventory_item.errors.any? %>
    <div class="alert">
      <h2><%= pluralize(@inventory_item.errors.count, "error") %> prohibited this inventory item from being saved:</h2>
      <ul>
        <% @inventory_item.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem;">
    <div>
      <%= f.label :code, "Code" %><br>
      <%= f.text_field :code, required: true, placeholder: "e.g. COP-15mm" %>
    </div>

    <div>
      <%= f.label :name, "Description" %><br>
      <%= f.text_field :name, required: true, placeholder: "e.g. 15mm Copper Pipe" %>
    </div>

    <div>
      <%= f.label :stock_item_type, "Stock Item Type" %><br>
      <%= f.text_field :stock_item_type, placeholder: "e.g. Consumable, Resale, Tool" %>
    </div>

    <div>
      <%= f.label :total_stock_quantity, "Total Stock Quantity" %><br>
      <%= f.number_field :total_stock_quantity, min: 0, step: 0.01 %>
    </div>

    <div>
      <%= f.label :cost_price, "Cost Price (R)" %><br>
      <%= f.number_field :cost_price, min: 0, step: 0.01 %>
    </div>

    <div>
      <%= f.label :list_price, "List Price (R)" %><br>
      <%= f.number_field :list_price, min: 0, step: 0.01 %>
    </div>

    <div>
      <%= f.label :replacement_percentage, "Replacement Percentage (%)" %><br>
      <%= f.number_field :replacement_percentage, min: 0, step: 0.01 %>
    </div>

    <div>
      <%= f.label :unit, "Unit" %><br>
      <%= f.text_field :unit, placeholder: "e.g. m, each, bag" %>
    </div>

    <div>
      <%= f.check_box :is_serializable %>
      <%= f.label :is_serializable, " Is Serializable" %>
    </div>

    <div>
      <%= f.check_box :is_quantity_tracked %>
      <%= f.label :is_quantity_tracked, " Is Quantity Tracked" %>
    </div>

    <div>
      <%= f.check_box :is_active %>
      <%= f.label :is_active, " Is Active" %>
    </div>

    <div></div>

    <div style="grid-column: 1 / -1;">
      <%= f.label :description, "Notes" %><br>
      <%= f.text_area :description, rows: 3, placeholder: "Optional notes..." %>
    </div>
  </div>

  <%= f.submit class: "btn", style: "margin-top: 1rem;" %>
<% end %>