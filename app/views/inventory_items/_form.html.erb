<%= form_with model: @inventory_item, local: true do |f| %>
  <% if @inventory_item.errors.any? %>
    <div class="alert">
      <h2><%= pluralize(@inventory_item.errors.count, "error") %> prohibited this inventory item from being saved:</h2>
      <ul>
        <% @inventory_item.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="margin-bottom: 1rem;">
    <%= f.label :code, "Code" %><br>
    <%= f.text_field :code, required: true, placeholder: "e.g. COP-15mm" %>
  </div>

  <div style="margin-bottom: 1rem;">
    <%= f.label :name, "Name" %><br>
    <%= f.text_field :name, required: true, placeholder: "e.g. 15mm Copper Pipe" %>
  </div>

  <div style="margin-bottom: 1rem;">
    <%= f.label :unit_price, "Unit Price (R)" %><br>
    <%= f.number_field :unit_price, min: 0, step: 0.01 %>
  </div>

  <div style="margin-bottom: 1rem;">
    <%= f.label :unit, "Unit" %><br>
    <%= f.text_field :unit, placeholder: "e.g. m, each, bag" %>
  </div>

  <div style="margin-bottom: 1rem;">
    <%= f.label :description %><br>
    <%= f.text_area :description, placeholder: "Optional notes..." %>
  </div>

  <%= f.submit class: "btn" %>
<% end %>
