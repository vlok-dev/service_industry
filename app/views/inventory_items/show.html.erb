<p><%= link_to "← Back to Inventory", inventory_items_path, class: "btn" %></p>

<h1><%= @inventory_item.code %> — <%= @inventory_item.name %></h1>

<div style="background: #f9fafb; padding: 1rem; margin-bottom: 1rem; border-radius: 4px;">
  <p><strong>Code:</strong> <%= @inventory_item.code %></p>
  <p><strong>Name:</strong> <%= @inventory_item.name %></p>
  <p><strong>Unit Price (R):</strong> <%= number_with_precision(@inventory_item.unit_price, precision: 2) if @inventory_item.unit_price %></p>
  <p><strong>Unit:</strong> <%= @inventory_item.unit || "—" %></p>
  <% if @inventory_item.description.present? %>
    <p><strong>Description:</strong> <%= simple_format(@inventory_item.description) %></p>
  <% end %>
</div>

<p>
  <%= link_to "Edit", edit_inventory_item_path(@inventory_item), class: "btn" %>
  <%= button_to "Delete", @inventory_item, method: :delete, data: { confirm: "Delete this inventory item?" }, class: "btn btn-danger", style: "display: inline;" %>
</p>
