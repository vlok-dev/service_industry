<h1>Calendar</h1>

<div style="margin-bottom: 1rem;">
  <%= link_to "Day", calendar_path(view: "day", date: @date), class: "btn" %>
  <%= link_to "Week", calendar_path(view: "week", date: @date), class: "btn" %>
  <%= link_to "Month", calendar_path(view: "month", date: @date), class: "btn" %>
  <%= link_to "← Previous", calendar_previous_path(view: @view, date: @date), class: "btn" %>
  <%= link_to "Next →", calendar_next_path(view: @view, date: @date), class: "btn" %>
  <%= link_to "Today", calendar_path(view: @view), class: "btn" %>
</div>

<h2>
  <% case @view %>
  <% when "day" %>
    <%= @date.strftime("%A, %B %d, %Y") %>
  <% when "week" %>
    Week of <%= @week_start.strftime("%B %d, %Y") %>
  <% when "month" %>
    <%= @month_start.strftime("%B %Y") %>
  <% end %>
</h2>

<% if @view == "day" %>
  <table>
    <thead>
      <tr>
        <th>Time</th>
        <th>Customer</th>
        <th>Address</th>
        <th>Plumber</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if @jobs.any? %>
        <% @jobs.order(:scheduled_time).each do |job| %>
          <tr>
            <td><%= job.scheduled_time&.strftime("%H:%M") || "—" %></td>
            <td><%= job.customer_name %></td>
            <td><%= job.address %></td>
            <td><%= job.assigned_to&.name || "Unassigned" %></td>
            <td><span class="badge badge-<%= job.status %>"><%= job.status.humanize %></span></td>
            <td><%= link_to "View", job %></td>
          </tr>
        <% end %>
      <% else %>
        <tr><td colspan="6">No jobs scheduled for this day.</td></tr>
      <% end %>
    </tbody>
  </table>

<% elsif @view == "week" %>
  <% (@week_start..(@week_start + 6.days)).each do |day| %>
    <h3><%= day.strftime("%A, %B %d") %></h3>
    <% day_jobs = @jobs_by_date[day] || [] %>
    <% if day_jobs.any? %>
      <ul>
        <% day_jobs.order(:scheduled_time).each do |job| %>
          <li>
            <strong><%= job.scheduled_time&.strftime("%H:%M") || "—" %></strong> —
            <%= link_to "#{job.customer_name} - #{job.address.truncate(40)}", job %>
            (<%= job.assigned_to&.name || "Unassigned" %>)
            — <span class="badge badge-<%= job.status %>"><%= job.status.humanize %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p style="color: #999; margin-left: 1rem;">No jobs</p>
    <% end %>
  <% end %>

<% elsif @view == "month" %>
  <% start_date = @month_start.beginning_of_week %>
  <% end_date = @month_start.end_of_month.end_of_week %>
  <table style="width: 100%; border-collapse: collapse;">
    <thead>
      <tr style="background: #f3f4f6;">
        <% %w[Sun Mon Tue Wed Thu Fri Sat].each do |day_name| %>
          <th style="padding: 0.5rem; border: 1px solid #e5e7eb; text-align: center;"><%= day_name %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% (start_date..end_date).each_slice(7) do |week| %>
        <tr>
          <% week.each do |day| %>
            <td style="padding: 0.5rem; border: 1px solid #e5e7eb; vertical-align: top; height: 100px; width: 14.28%; <%= 'background: #f9fafb;' if day.month != @month_start.month %>">
              <div style="font-weight: <%= day == Date.today ? 'bold' : 'normal' %>; color: <%= day.month == @month_start.month ? '#000' : '#999' %>;">
                <%= day.day %>
              </div>
              <% day_jobs = @jobs_by_date[day] || [] %>
              <% day_jobs.first(3).each do |job| %>
                <div style="font-size: 0.75rem; background: #dbeafe; padding: 2px 4px; margin-top: 2px; border-radius: 3px;">
                  <%= job.scheduled_time&.strftime("%H:%M") %> <%= link_to job.customer_name.truncate(15), job %>
                </div>
              <% end %>
              <% if day_jobs.size > 3 %>
                <div style="font-size: 0.75rem; color: #6b7280; margin-top: 2px;">+<%= day_jobs.size - 3 %> more</div>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>