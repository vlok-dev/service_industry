<div class="calendar-view">
  <div class="calendar-toolbar">
    <%= link_to "Day", calendar_path(view: "day", date: @date), class: "btn" %>
    <%= link_to "Week", calendar_path(view: "week", date: @date), class: "btn" %>
    <%= link_to "Month", calendar_path(view: "month", date: @date), class: "btn" %>
    <%= link_to "← Previous", calendar_previous_path(view: @view, date: @date), class: "btn" %>
    <%= link_to "Next →", calendar_next_path(view: @view, date: @date), class: "btn" %>
    <%= link_to "Today", calendar_path(view: @view), class: "btn" %>
  </div>

  <h2 class="calendar-title">
    <% case @view %>
    <% when "day" %>
      <%= @date.strftime("%A, %B %d, %Y") %>
    <% when "week" %>
      Week of <%= @week_start.strftime("%B %d, %Y") %>
    <% when "month" %>
      <%= @month_start.strftime("%B %Y") %>
    <% end %>
  </h2>

  <% if @view == "day" %>
    <table class="calendar-table">
      <thead>
        <tr>
          <th>Time</th>
          <th>Customer</th>
          <th>Address</th>
          <th>Plumber</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if @jobs.any? %>
          <% @jobs.order(:scheduled_time).each do |job| %>
            <tr>
              <td><%= job.scheduled_time&.strftime("%I:%M %p")&.strip || "—" %></td>
              <td><%= job.customer_name %></td>
              <td><%= job.address %></td>
              <td><%= job.assigned_to&.name || "Unassigned" %></td>
              <td><span class="badge badge-<%= job.display_status_key %>"><%= job.display_status %></span></td>
              <td><%= link_to "View", job %></td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="6">No jobs scheduled for this day.</td></tr>
        <% end %>
      </tbody>
    </table>

  <% elsif @view == "week" %>
    <% (@week_start..(@week_start + 6.days)).each do |day| %>
      <h3 class="calendar-day-heading"><%= day.strftime("%A, %B %d") %></h3>
      <% day_jobs = @jobs_by_date[day] || [] %>
      <% if day_jobs.any? %>
        <ul class="calendar-week-list">
          <% day_jobs.order(:scheduled_time).each do |job| %>
            <li>
              <strong><%= job.scheduled_time&.strftime("%I:%M %p")&.strip || "—" %></strong> —
              <%= link_to "#{job.customer_name} - #{job.address.truncate(40)}", job %>
              (<%= job.assigned_to&.name || "Unassigned" %>)
              — <span class="badge badge-<%= job.display_status_key %>"><%= job.display_status %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="calendar-empty">No jobs</p>
      <% end %>
    <% end %>

  <% elsif @view == "month" %>
    <table class="calendar-month-table">
      <thead>
        <tr>
          <% %w[Sun Mon Tue Wed Thu Fri Sat].each do |day_name| %>
            <th><%= day_name %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% start_date = @month_start.beginning_of_week(:sunday) %>
        <% end_date = @month_start.end_of_month.end_of_week(:sunday) %>
        <% (start_date..end_date).each_slice(7) do |week| %>
          <tr>
            <% week.each do |day| %>
              <td class="calendar-month-cell"
                  data-outside="<%= day.month != @month_start.month %>">
                <div class="calendar-month-day <%= 'today' if day == Date.today %>">
                  <%= day.day %>
                </div>
                <% day_jobs = @jobs_by_date[day] || [] %>
                <% day_jobs.first(3).each do |job| %>
                  <div class="calendar-month-job">
                    <span class="calendar-month-time"><%= job.scheduled_time&.strftime("%I:%M %p")&.strip %></span>
                    <%= link_to job.customer_name.truncate(15), job, class: "calendar-month-link" %>
                  </div>
                <% end %>
                <% if day_jobs.size > 3 %>
                  <div class="calendar-month-more">+<%= day_jobs.size - 3 %> more</div>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>