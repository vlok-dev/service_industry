<!DOCTYPE html>
<html>
  <head>
    <title>Offline - Industro Plumbers</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <style>
      body { font-family: system-ui, sans-serif; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; background: #f3f4f6; }
      .offline-card { text-align: center; padding: 2rem; background: white; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); max-width: 400px; }
      h1 { color: #1e3a8a; margin-bottom: 0.5rem; }
      p { color: #6b7280; }
    </style>
