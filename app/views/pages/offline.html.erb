  <body>
    <div class="offline-card">
      <h1>You're Offline</h1>
      <p>The app is still available, but changes will be saved locally until you're back online.</p>
      <p id="connection-status" style="font-weight: 600; color: #059669;"></p>
    </div>
  </body>
</html>