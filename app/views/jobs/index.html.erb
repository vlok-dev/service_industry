<%
  pipeline_scope = current_user.super_admin? ? policy_scope(Job).where(user: current_user) : policy_scope(Job)
  counts = {
    pending:    pipeline_scope.where(status: :pending).count,
    scheduled:  pipeline_scope.where(status: :scheduled).count,
    in_progress: pipeline_scope.where(status: :in_progress).count,
    completed:  pipeline_scope.where(status: :completed).count,
    cancelled:  pipeline_scope.where(status: :cancelled).count,
    invoiced:   pipeline_scope.invoiced.count,
    outstanding: pipeline_scope.outstanding.count
  }
  current_filter = params[:filter]
  filter_date = params[:filter_date].present? ? Date.parse(params[:filter_date]) : nil
%>

<div class="action-bar">
  <div>
    <h1>Jobs</h1>
    <p style="margin: 0.25rem 0 0; color: var(--text-muted); font-size: 0.9rem;">
      <% if @current_tab == "purchase_orders" %>
        <%= pluralize(@purchase_orders.count, "purchase order") %>
      <% else %>
        <%= pluralize(@pipeline_scope.count, "job") %> • <%= number_with_precision(counts[:completed] * 100.0 / [@pipeline_scope.count, 1].max, precision: 0) %>% completion rate
      <% end %>
    </p>
  </div>
   <div class="actions">
    <% if current_user.super_admin? && @current_tab != "purchase_orders" %>
      <%= link_to new_job_path, class: "btn" do %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        New Job
      <% end %>
    <% end %>
    <% if (current_user.scheduler? || current_user.super_admin?) && @current_tab != "purchase_orders" %>
      <%= link_to(print_tomorrow_jobs_path, class: "btn btn-print-jobs", target: "_blank") do %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7"></path><path d="M6 18h12v6H6v-6z"></path></svg>
        Print Tomorrow's Jobs
      <% end %>
    <% end %>
  </div>
</div>

<% if current_user.reporter? %>
  <div class="tab-row" style="margin-bottom: 1.5rem;">
    <%= link_to jobs_path(tab: "jobs"), class: "tab #{@current_tab == 'jobs' ? 'active' : ''}" do %>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
      Jobs
    <% end %>
    <%= link_to jobs_path(tab: "purchase_orders"), class: "tab #{@current_tab == 'purchase_orders' ? 'active' : ''}" do %>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
      Purchase Orders
    <% end %>
  </div>
<% end %>

<% if current_user %>
  <div class="kpi-strip">
    <div class="kpi kpi-pending">
      <div class="label">Pending</div>
      <div class="value"><%= counts[:pending] %></div>
      <div class="sub">Awaiting schedule</div>
    </div>
    <div class="kpi kpi-scheduled">
      <div class="label">Scheduled</div>
      <div class="value"><%= counts[:scheduled] %></div>
      <div class="sub">Booked in</div>
    </div>
    <div class="kpi kpi-progress">
      <div class="label">In Progress</div>
      <div class="value"><%= counts[:in_progress] %></div>
      <div class="sub">Active on site</div>
    </div>
    <div class="kpi kpi-completed">
      <div class="label">Completed</div>
      <div class="value"><%= counts[:completed] %></div>
      <div class="sub">All done</div>
    </div>
    <div class="kpi kpi-invoiced">
      <div class="label">Invoiced</div>
      <div class="value"><%= counts[:invoiced] %></div>
      <div class="sub">Invoice issued</div>
    </div>
    <% if counts[:cancelled] > 0 %>
      <div class="kpi kpi-cancelled">
        <div class="label">Cancelled</div>
        <div class="value"><%= counts[:cancelled] %></div>
        <div class="sub">Did not run</div>
      </div>
    <% end %>
  </div>
<% end %>

<div class="search-bar">
  <%= form_with url: jobs_path, method: :get, local: true, style: "display: contents;" do |f| %>
    <%= f.text_field :q, value: @search_query, placeholder: "Search by job #, address, customer, invoice..." %>
    <%= f.hidden_field :tab, value: @current_tab %>
    <% if current_filter.present? %>
      <%= f.hidden_field :filter, value: current_filter %>
    <% end %>
    <% if current_filter == "scheduled" && params[:filter_date].present? %>
      <%= f.hidden_field :filter_date, value: params[:filter_date] %>
    <% end %>
    <%= f.submit "Search", class: "btn" %>
    <% if @search_query.present? || current_filter.present? %>
      <%= link_to "Clear", jobs_path(tab: @current_tab), class: "btn btn-secondary" %>
    <% end %>
  <% end %>
</div>

<div class="chip-row">
  <%= link_to "All", jobs_path(tab: @current_tab), class: "chip #{current_filter.blank? ? 'active' : ''}" %>
  <%= link_to jobs_path(filter: "outstanding", tab: @current_tab), class: "chip #{current_filter == 'outstanding' ? 'active' : ''}" do %>
    Outstanding
    <span class="count"><%= counts[:outstanding] %></span>
  <% end %>
  <%= link_to jobs_path(filter: "pending", tab: @current_tab), class: "chip #{current_filter == 'pending' ? 'active' : ''}" do %>
    Pending
    <span class="count"><%= counts[:pending] %></span>
  <% end %>
  <%= link_to jobs_path(filter: "scheduled", tab: @current_tab), class: "chip #{current_filter == 'scheduled' ? 'active' : ''}" do %>
    Scheduled
    <span class="count"><%= counts[:scheduled] %></span>
  <% end %>
  <%= link_to jobs_path(filter: "in_progress", tab: @current_tab), class: "chip #{current_filter == 'in_progress' ? 'active' : ''}" do %>
    In Progress
    <span class="count"><%= counts[:in_progress] %></span>
  <% end %>
  <%= link_to jobs_path(filter: "completed", tab: @current_tab), class: "chip #{current_filter == 'completed' ? 'active' : ''}" do %>
    Completed
    <span class="count"><%= counts[:completed] %></span>
  <% end %>
  <%= link_to jobs_path(filter: "invoiced", tab: @current_tab), class: "chip #{current_filter == 'invoiced' ? 'active' : ''}" do %>
    Invoiced
    <span class="count"><%= counts[:invoiced] %></span>
  <% end %>
</div>

<% if current_filter == "scheduled" && @current_tab == "jobs" %>
  <div class="scheduled-date-picker" style="margin-bottom: 1rem; display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; background: var(--surface); border: 1px solid var(--border-light); border-radius: var(--radius); box-shadow: var(--shadow);">
    <label for="filter_date" style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted); margin: 0;">Show scheduled jobs for:</label>
    <%= form_with url: jobs_path(filter: "scheduled", tab: "jobs"), method: :get, local: true, style: "display: flex; align-items: center; gap: 0.5rem;" do |f| %>
      <%= f.hidden_field :filter, value: "scheduled" %>
      <%= f.hidden_field :tab, value: "jobs" %>
      <%= f.date_field :filter_date, value: filter_date || Date.tomorrow, id: "filter_date", style: "padding: 0.4rem 0.6rem; border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 0.85rem;", onchange: "this.form.requestSubmit();" %>
      <% if filter_date.present? %>
        <%= link_to "Clear date", jobs_path(filter: "scheduled", tab: "jobs"), class: "btn btn-sm btn-secondary" %>
      <% end %>
    <% end %>
  </div>
<% end %>

<% if @current_tab == "jobs" && (current_user.super_admin? || current_user.scheduler? || current_user.accountant? || current_user.reporter?) %>
  <div class="card" style="margin-bottom: 1.5rem;">
    <div class="card-header">
      <h2><%= filter_display_name(current_filter) %> Jobs</h2>
      <div style="display: flex; gap: 0.75rem; align-items: center;">
        <%= form_with url: jobs_path(tab: "jobs"), method: :get, local: true, style: "display: flex; gap: 0.5rem;" do |f| %>
          <%= f.hidden_field :tab, value: "jobs" %>
          <%= f.text_field :q, value: @search_query, placeholder: "Search by job #, customer, address...", style: "padding: 0.5rem 0.75rem; border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 0.875rem; width: 280px;" %>
          <%= f.submit "Search", class: "btn btn-sm" %>
          <% if @search_query.present? %>
            <%= link_to "Clear", jobs_path(tab: "jobs"), class: "btn btn-sm btn-secondary" %>
          <% end %>
        <% end %>
        <% if current_user.super_admin? %>
          <%= link_to "New Job", new_job_path, class: "btn" %>
        <% end %>
      </div>
    </div>
    <div class="card-body no-padding">
      <% if @pipeline_jobs.present? %>
        <div class="modern-table" style="border: none; box-shadow: none; border-radius: 0;">
        <table>
          <thead>
            <tr>
              <th><%= sortable_header "Job #", "job_number" %></th>
              <th><%= sortable_header "Date", "scheduled_date" %></th>
              <th><%= sortable_header "Time", "scheduled_time" %></th>
              <th><%= sortable_header "Customer", "customer_name" %></th>
              <th><%= sortable_header "Problem", "description" %></th>
              <th><%= sortable_header "Address", "address" %></th>
              <th><%= sortable_header "Status", "status" %></th>
              <th><%= sortable_header "Job Type", "is_project" %></th>
              <th><%= sortable_header "Assigned To", "assigned_to" %></th>
              <th><%= sortable_header "Invoice", "invoice_number" %></th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @pipeline_jobs.each do |job| %>
              <tr data-job-id="<%= job.id %>">
              <td><%= link_to (job.job_number || "N/A"), job, class: "job-number", title: "View job" %></td>
                <td><%= date_columns_display(job.scheduled_date) %></td>
                <td><%= job.scheduled_time&.strftime("%I:%M %p")&.strip || "—" %></td>
                <td><%= job.customer_name %></td>
                <td><%= job.description.to_s.truncate(60) %></td>
                <td><%= job.address.to_s.truncate(40) %></td>
                <td><%= render "dashboard/status_dropdown", job: job %></td>
                <td><%= render "dashboard/job_type_dropdown", job: job %></td>
                <td><%= render "dashboard/assigned_to_dropdown", job: job %></td>
                <td><%= job.invoice_number || "—" %></td>
                <td>
                  <div class="actions-icon">
                    <button type="button" class="row-colour-btn" title="Row Colour">Row Colour</button>
                    <% if job.pending? && policy(job).schedule? %>
                      <button type="button" class="btn btn-sm btn-schedule-toggle" data-job-id="<%= job.id %>">
                        Schedule
                      </button>
                    <% end %>
                    <%= link_to job, class: "btn-icon btn-icon-primary", title: "View" do %>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    <% end %>
                    <% if current_user.accountant? && policy(job).edit? %>
                      <%= link_to "Assign Invoice", edit_job_path(job), class: "btn btn-sm", title: "Assign Invoice" %>
                    <% end %>
                    <% if !job.completed? && policy(job).close? %>
                      <%= button_to close_job_path(job), method: :patch, data: { confirm: "Close this job and mark it as completed with invoice?" }, class: "btn-icon btn-icon-success", title: "Close Job" do %>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                      <% end %>
                    <% end %>
                    <% if policy(job).edit? %>
                      <%= link_to edit_job_path(job), class: "btn-icon btn-icon-edit", title: "Edit" do %>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                      <% end %>
                    <% end %>
                    <% if policy(job).destroy? %>
                      <%= button_to job, method: :delete, data: { confirm: "Are you sure?" }, class: "btn-icon btn-icon-danger", title: "Delete" do %>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
              <% if job.pending? && policy(job).schedule? %>
                <tr id="schedule-row-<%= job.id %>" class="schedule-row" style="display: none;">
                  <td colspan="11">
                    <div class="schedule-form">
                      <%= form_with url: schedule_job_path(job), method: :patch, local: true do |f| %>
                        <%= f.hidden_field :status, value: "scheduled" %>
                        <div style="display: flex; flex-direction: column; gap: 0.375rem;">
                          <%= f.date_field :scheduled_date, value: job.scheduled_date || Date.today, required: true, style: "padding: 0.4rem; border: 1px solid var(--border); border-radius: 6px; font-size: 0.875rem;" %>
                          <%= f.time_field :scheduled_time, value: (job.scheduled_time&.strftime("%H:%M") || ""), style: "padding: 0.4rem; border: 1px solid var(--border); border-radius: 6px; font-size: 0.875rem;" %>
                          <%= f.select :assigned_to_id, options_from_collection_for_select(User.plumber, :id, :name, job.assigned_to_id), { include_blank: "Plumber" }, { style: "padding: 0.4rem; border: 1px solid var(--border); border-radius: 6px; font-size: 0.875rem;" } %>
                          <div style="display: flex; gap: 0.5rem;">
                            <%= f.submit "Save", class: "btn btn-sm btn-success" %>
                            <button type="button" class="btn btn-sm btn-secondary btn-cancel-schedule" data-job-id="<%= job.id %>">Cancel</button>
                          </div>
                        </div>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
        </div>

        <% if @pagy.pages > 1 %>
          <div class="pagination-nav" style="padding: 1rem; display: flex; justify-content: center; gap: 0.5rem; flex-wrap: wrap;">
            <%= @pagy.series_nav %>
          </div>
        <% end %>

      <% else %>
        <div class="empty-state">Nothing here for the moment!</div>
      <% end %>
    </div>
  </div>
<% end %>

<% if @current_tab == "purchase_orders" && current_user.reporter? %>
  <div class="card" style="margin-bottom: 1.5rem;">
    <div class="card-header">
      <h2>Purchase Orders</h2>
      <div style="display: flex; gap: 0.75rem; align-items: center;">
        <%= form_with url: jobs_path(tab: "purchase_orders"), method: :get, local: true, style: "display: flex; gap: 0.5rem;" do |f| %>
          <%= f.hidden_field :tab, value: "purchase_orders" %>
          <%= f.text_field :q, value: params[:q], placeholder: "Search by PO #, Supplier, Job #, Customer...", style: "padding: 0.5rem 0.75rem; border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 0.875rem; width: 320px;" %>
          <%= f.submit "Search", class: "btn btn-sm" %>
          <% if params[:q].present? %>
            <%= link_to "Clear", jobs_path(tab: "purchase_orders"), class: "btn btn-sm btn-secondary" %>
          <% end %>
        <% end %>
      </div>
    </div>
    <div class="card-body no-padding">
      <% if @purchase_orders.present? %>
        <div class="modern-table" style="border: none; box-shadow: none; border-radius: 0;">
        <table>
          <thead>
            <tr>
              <th>PO #</th>
              <th>Job #</th>
              <th>Customer</th>
              <th>Supplier</th>
              <th>Order Date</th>
              <th>Items</th>
              <th>Total (incl. VAT)</th>
              <th>Created By</th>
              <th>Created</th>
            </tr>
          </thead>
          <tbody>
            <% @purchase_orders.each do |po| %>
              <tr>
                <td><%= link_to po.po_number, job_purchase_order_path(po.job, po), class: "job-number", title: "View Purchase Order" %></td>
                <td><%= link_to (po.job.job_number || "N/A"), job_path(po.job), class: "job-number", title: "View Job" %></td>
                <td><%= po.job.customer_name %></td>
                <td><%= po.supplier_display_name %></td>
                <td><%= po.order_date&.strftime("%d %b %Y") %></td>
                <td><%= po.items.count %></td>
                <td><%= number_to_currency(po.total_amount || po.total_including_vat, unit: "R", precision: 2) %></td>
                <td><%= po.created_by&.name %></td>
                <td><%= po.created_at&.strftime("%d %b %Y %H:%M") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
        </div>

        <% if @pagy.pages > 1 %>
          <div class="pagination-nav" style="padding: 1rem; display: flex; justify-content: center; gap: 0.5rem; flex-wrap: wrap;">
            <%= @pagy.series_nav %>
          </div>
        <% end %>

      <% else %>
        <div class="empty-state">No purchase orders found.</div>
      <% end %>
    </div>
  </div>
<% end %>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.btn-schedule-toggle').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var jobId = btn.getAttribute('data-job-id');
        var row = document.getElementById('schedule-row-' + jobId);
        if (row) {
          row.style.display = row.style.display === 'none' ? 'table-row' : 'none';
        }
      });
    });

    document.querySelectorAll('.btn-cancel-schedule').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var jobId = btn.getAttribute('data-job-id');
        var row = document.getElementById('schedule-row-' + jobId);
        if (row) {
          row.style.display = 'none';
        }
      });
    });
  });
</script>