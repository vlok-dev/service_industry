<p><%= link_to "Back to Jobs", jobs_path, class: "btn" %></p>

<h1>Job Details</h1>

<p><strong>Customer:</strong> <%= @job.customer_name %></p>
<p><strong>Address:</strong> <%= @job.address %></p>
<p><strong>Description:</strong> <%= @job.description %></p>
<p><strong>Status:</strong> <span class="badge badge-<%= @job.status %>"><%= @job.status.humanize %></span></p>
<p><strong>Priority:</strong> <%= @job.priority.humanize %></p>
<p><strong>Scheduled Date:</strong> <%= @job.scheduled_date&.strftime("%Y-%m-%d") || "Not scheduled" %></p>
<p><strong>Scheduled Time:</strong> <%= @job.scheduled_time&.strftime("%H:%M") || "Not scheduled" %></p>
<p><strong>Assigned To:</strong> <%= @job.assigned_to&.name || "Unassigned" %></p>
<p><strong>Notes:</strong> <%= @job.notes || "None" %></p>
<p><strong>Logged By:</strong> <%= @job.user.name %></p>

<% if policy(@job).edit? %>
  <%= link_to "Edit", edit_job_path(@job), class: "btn" %>
<% end %>
<% if policy(@job).show? %>
  <%= link_to "Send WhatsApp", whatsapp_job_path(@job), class: "btn", data: { confirm: "Open WhatsApp to send job details to plumber?" } %>
<% end %>

<h3>Purchase Orders</h3>
<% if @job.purchase_orders.any? %>
  <table>
    <thead>
      <tr>
        <th>PO #</th>
        <th>Supplier</th>
        <th>Order Date</th>
        <th>Expected Delivery</th>
        <th>Status</th>
        <th>Total</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @job.purchase_orders.includes(:items).each do |po| %>
        <tr>
          <td><%= po.po_number || "N/A" %></td>
          <td><%= po.supplier_name %></td>
          <td><%= po.order_date&.strftime("%Y-%m-%d") %></td>
          <td><%= po.expected_delivery&.strftime("%Y-%m-%d") %></td>
          <td><span class="badge badge-<%= po.status %>"><%= po.status.humanize %></span></td>
          <td>R <%= number_with_precision(po.subtotal, precision: 2) %></td>
          <td><%= link_to "View", job_purchase_order_path(@job, po), class: "btn" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No purchase orders for this job.</p>
<% end %>

<%= link_to "Add Purchase Order", new_job_purchase_order_path(@job), class: "btn btn-success" %>