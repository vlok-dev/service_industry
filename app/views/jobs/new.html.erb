<p><%= link_to "Back to Jobs", jobs_path, class: "btn" %></p>

<h1>New Job</h1>

<%= form_with model: @job, local: true do |f| %>
  <% if @job.errors.any? %>
    <div class="alert">
      <h2><%= pluralize(@job.errors.count, "error") %> prohibited this job from being saved:</h2>
      <ul>
        <% @job.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="margin-bottom: 1rem;">
    <%= f.label :client_id, "Client" %><br>
    <%= f.collection_select :client_id, Client.ordered, :id, :name, { include_blank: "Select a client (optional)" }, { onchange: "populateFromClient(this.value);" } %>
    <p style="color: #666; font-size: 0.875rem;">Optional: Select a saved client to auto-fill customer name and address.</p>
  </div>

  <div style="margin-bottom: 1rem;">
    <%= f.label :customer_name, "Customer Name" %><br>
    <%= f.text_field :customer_name, required: true %>
  </div>

  <div style="margin-bottom: 1rem;">
    <%= f.label :address %><br>
    <%= f.text_area :address, required: true %>
  </div>

  <div style="margin-bottom: 1rem;">
    <%= f.label :contact_number, "Contact Number" %><br>
    <%= f.text_field :contact_number, placeholder: "Phone number to reach the client" %>
  </div>

  <div style="margin-bottom: 1rem;">
    <%= f.label :description %><br>
    <%= f.text_area :description, required: true %>
  </div>

  <div style="margin-bottom: 1rem;">
    <%= f.label :status %><br>
    <%= f.select :status, Job.statuses.keys.map { |s| [s.humanize, s] }, { include_blank: true }, { required: true } %>
  </div>

  <div style="margin-bottom: 1rem;">
    <%= f.label :priority %><br>
    <%= f.select :priority, Job.priorities.keys.map { |p| [p.humanize, p] }, { include_blank: true }, { required: true } %>
  </div>

  <div style="margin-bottom: 1rem;">
    <%= f.label :assigned_to_id, "Assign Plumber" %><br>
    <%= f.select :assigned_to_id, options_from_collection_for_select(User.plumber, :id, :name, f.object.assigned_to_id), { include_blank: "Select Plumber (optional)" } %>
  </div>

  <div style="margin-bottom: 1rem;">
    <%= f.label :notes %><br>
    <%= f.text_area :notes %>
  </div>

  <div style="margin-bottom: 1rem;">
    <%= f.label :job_number, "Job Number" %><br>
    <%= f.text_field :job_number, placeholder: "Auto-generated (e.g. JOB-00001) - leave blank for default" %>
    <p style="color: #666; font-size: 0.875rem;">Optional: Set a custom job number, or leave blank to auto-generate.</p>
  </div>

  <div style="margin-bottom: 1rem;">
    <%= f.label :invoice_number, "Invoice Number (when completed)" %><br>
    <%= f.text_field :invoice_number, placeholder: "Leave blank to auto-generate on completion" %>
  </div>

  <div style="margin-bottom: 1rem;">
    <%= f.label :is_project, "Project?" %><br>
    <%= f.check_box :is_project %>
    <p style="color: #666; font-size: 0.875rem;">Mark as a project to run over multiple days and attach claims.</p>
  </div>

  <div style="margin-bottom: 1rem;">
    <%= f.submit "Create Job", class: "btn" %>
  </div>

  <script>
    function populateFromClient(clientId) {
      if (!clientId) return;
      var clients = <%= raw Client.ordered.map { |c| [c.id, { name: c.name, address: c.delivery_address, phone_number: c.primary_contact_mobile }] }.to_json %>;
      var client = clients[clientId];
      if (client) {
        document.getElementById("job_customer_name").value = client.name;
        document.getElementById("job_address").value = client.address;
        document.getElementById("job_contact_number").value = client.phone_number || "";
      }
    }
  </script>

<% end %>