<div class="action-bar">
  <div>
    <h1>Add Job</h1>
    <p style="margin: 0.25rem 0 0; color: var(--text-muted); font-size: 0.9rem;">Create a new job entry</p>
  </div>
  <div class="actions">
    <%= link_to "Back to Jobs", jobs_path, class: "btn btn-secondary" %>
  </div>
</div>

<%= form_with model: @job, local: true, style: "display: contents;" do |f| %>
  <% if @job.errors.any? %>
    <div class="alert">
      <h2><%= pluralize(@job.errors.count, "error") %> prohibited this job from being saved:</h2>
      <ul>
        <% @job.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card" style="margin-bottom: 1.5rem;">
    <div class="card-header">
      <h2>Customer Details</h2>
    </div>
    <div class="card-body">
      <div class="field">
        <%= f.label :client_id, "Client" %>
        <div class="client-search-wrapper">
          <input type="hidden" name="job[client_id]" id="job_client_id" value="<%= @job.client_id %>">
          <input type="text" id="client_search" class="client-search-input" placeholder="Search clients to auto-fill..." autocomplete="off">
          <div id="client_dropdown" class="client-dropdown"></div>
        </div>
        <p style="color: var(--text-muted); font-size: 0.8rem; margin-top: 0.25rem;">Optional: Selecting a client auto-fills the fields below.</p>
      </div>

      <div class="field" id="client_address_wrapper" style="display: none;">
        <%= f.label :address, "Select Client Address" %>
        <select id="client_address_select" name="client_address_select" class="form-control" style="width: 100%; padding: 0.5rem;">
          <option value="">— Select an address —</option>
        </select>
        <p style="color: var(--text-muted); font-size: 0.8rem; margin-top: 0.25rem;">Choose from this client's saved addresses. The first match auto-fills the delivery address below.</p>
      </div>

      <div class="field">
        <%= f.label :customer_code, "Customer Code" %>
        <%= f.text_field :customer_code, placeholder: "Auto-filled when client selected" %>
      </div>

      <div class="field">
        <%= f.label :customer_name, "Customer Name" %>
        <%= f.text_field :customer_name, required: true, placeholder: "Enter customer name" %>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
        <div class="field">
          <%= f.label :contact_person, "Primary Contact" %>
          <%= f.text_field :contact_person, placeholder: "Auto-filled when client selected" %>
        </div>
        <div class="field">
          <%= f.label :email, "Primary Contact Email" %>
          <%= f.email_field :email, placeholder: "Auto-filled when client selected" %>
        </div>
        <div class="field">
          <%= f.label :contact_number, "Primary Contact Mobile" %>
          <%= f.text_field :contact_number, placeholder: "Auto-filled when client selected" %>
        </div>
      </div>

      <div class="field">
        <%= f.label :address, "Primary Delivery Address" %>
        <%= f.text_area :address, rows: 2, required: true, placeholder: "Enter delivery address" %>
      </div>

      <div class="field">
        <%= f.label :postal_address, "Primary Postal Address" %>
        <%= f.text_area :postal_address, rows: 2, placeholder: "Auto-filled when client selected" %>
        <p style="color: var(--text-muted); font-size: 0.8rem;">Same as delivery if blank on client.</p>
      </div>
    </div>
  </div>

  <div class="card" style="margin-bottom: 1.5rem;">
    <div class="card-header">
      <h2>Job Details</h2>
    </div>
    <div class="card-body">
      <div class="field">
        <%= f.label :description %>
        <%= f.text_area :description, required: true, rows: 3, placeholder: "Describe the work to be done" %>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
        <div class="field">
          <%= f.label :status %>
          <%= f.select :status, Job.statuses.keys.map { |s| [s.humanize, s] }, { include_blank: false } %>
        </div>
        <div class="field">
          <%= f.label :priority %>
          <%= f.select :priority, Job.priorities.keys.map { |p| [p.humanize, p] }, { include_blank: false } %>
        </div>
        <div class="field">
          <%= f.label :assigned_to_id, "Assign Plumber" %>
          <%= f.select :assigned_to_id, options_from_collection_for_select(User.plumber, :id, :name, f.object.assigned_to_id), { include_blank: "Select Plumber (optional)" } %>
        </div>
      </div>

      <div class="field">
        <%= f.label :notes %>
        <%= f.text_area :notes, rows: 2, placeholder: "Optional notes" %>
      </div>
    </div>
  </div>

  <div class="card" style="margin-bottom: 1.5rem;">
    <div class="card-header">
      <h2>Scheduling</h2>
    </div>
    <div class="card-body">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem;">
        <div class="field">
          <%= f.label :scheduled_date, "Scheduled Date" %>
          <%= f.date_field :scheduled_date %>
        </div>
        <div class="field">
          <%= f.label :scheduled_time, "Scheduled Time" %>
          <%= f.time_field :scheduled_time %>
        </div>
        <div class="field">
          <%= f.label :scheduled_end_date, "Scheduled End Date" %>
          <%= f.date_field :scheduled_end_date %>
        </div>
      </div>
      <p style="color: var(--text-muted); font-size: 0.8rem; margin-top: 0.5rem;">End date required for multi-day projects.</p>
    </div>
  </div>

  <div class="card" style="margin-bottom: 1.5rem;">
    <div class="card-header">
      <h2>Additional Settings</h2>
    </div>
    <div class="card-body">
      <div class="field">
        <%= f.label :is_project, "Project?" %>
        <%= f.check_box :is_project %>
        <span style="font-size: 0.875rem; color: var(--text-muted);">Mark as a project to run over multiple days and attach claims.</span>
      </div>

      <div class="field">
        <%= f.label :job_number, "Job Number" %>
        <%= f.text_field :job_number, placeholder: "Auto-generated (e.g. JOB-00001) - leave blank for default" %>
        <p style="color: var(--text-muted); font-size: 0.8rem;">Optional: Set a custom job number, or leave blank to auto-generate.</p>
      </div>

      <div class="field">
        <%= f.label :invoice_number, "Invoice Number (when completed)" %>
        <%= f.text_field :invoice_number, placeholder: "Leave blank to auto-generate on completion" %>
      </div>
    </div>
  </div>

  <div style="display: flex; gap: 0.75rem; justify-content: flex-end;">
    <%= link_to "Cancel", jobs_path, class: "btn btn-secondary" %>
    <%= f.submit "Create Job", class: "btn" %>
  </div>
<% end %>

  <script>
    var clientsData = <%= raw Client.ordered.includes(:addresses).map { |c| [
      c.id,
      {
        customer_code: c.customer_code,
        name: c.name,
        contact_person: c.contact_person,
        email: c.email,
        phone_number: c.primary_contact_mobile || c.phone_number,
        delivery_address: c.delivery_address,
        postal_address: c.postal_address || c.delivery_address,
        addresses: c.addresses.order(id: :asc).map { |a| { id: a.id, label: a.label, address: a.address, is_default: a.is_default } }
      }
    ] }.to_h.to_json %>;

    function populateFromClient(clientId) {
      var c = clientsData[clientId];
      var fields = {
        "job_customer_code": c && c.customer_code,
        "job_customer_name": c && c.name,
        "job_contact_person": c && c.contact_person,
        "job_email": c && c.email,
        "job_contact_number": c && c.phone_number,
        "job_address": c && c.delivery_address,
        "job_postal_address": c && c.postal_address
      };
      Object.keys(fields).forEach(function(id) {
        var el = document.getElementById(id);
        if (el) el.value = fields[id] || "";
      });

      var addressSelect = document.getElementById('client_address_select');
      var addressWrapper = document.getElementById('client_address_wrapper');
      if (addressWrapper) addressWrapper.style.display = (c && c.addresses.length > 0) ? '' : 'none';
      if (addressSelect && c && c.addresses) {
        addressSelect.innerHTML = '<option value="">— Select an address —</option>';
        c.addresses.forEach(function(a) {
          var label = a.label + ": " + a.address;
          var opt = document.createElement('option');
          opt.value = a.address;
          opt.textContent = label;
          if (a.is_default) opt.selected = true;
          addressSelect.appendChild(opt);
        });
        addressSelect.style.display = '';
        var firstOpt = addressSelect.querySelector('option[value=""]');
        if (firstOpt) firstOpt.style.display = 'none';
        var defaultOpt = addressSelect.querySelector('option[selected="selected"]');
        if (defaultOpt && c.addresses.length > 0) {
          addressSelect.value = defaultOpt.value;
          fields["job_address"] = defaultOpt.value;
          var addrEl = document.getElementById('job_address');
          if (addrEl) addrEl.value = defaultOpt.value;
        }
      } else if (addressSelect) {
        addressSelect.innerHTML = '<option value="">No addresses</option>';
        addressSelect.style.display = '';
      }
    }

    var addressSelectEl = document.getElementById('client_address_select');
    if (addressSelectEl) {
      addressSelectEl.addEventListener('change', function() {
        var addrEl = document.getElementById('job_address');
        if (addrEl && this.value) addrEl.value = this.value;
      });
    }

    function initClientSearch() {
      var searchInput = document.getElementById('client_search');
      var dropdown = document.getElementById('client_dropdown');
      var hiddenInput = document.getElementById('job_client_id');
      if (!searchInput || !dropdown || !hiddenInput) return;

      var selectedId = hiddenInput.value;

      function renderClients(filterText) {
        var term = (filterText || '').toLowerCase();
        var html = '';
        var count = 0;
        Object.keys(clientsData).forEach(function(id) {
          var c = clientsData[id];
          var label = (c.customer_code ? c.customer_code + ' — ' : '') + c.name;
          if (term && label.toLowerCase().indexOf(term) === -1) return;
          count++;
          var selectedClass = (String(id) === String(selectedId)) ? ' active' : '';
          html += '<div class="client-option' + selectedClass + '" data-id="' + id + '"><span class="client-code">' + (c.customer_code || '—') + '</span><span class="client-name">' + (c.name || '').replace(/</g, '&lt;') + '</span></div>';
        });
        if (!count) {
          html = '<div class="client-no-results">No clients found</div>';
        }
        dropdown.innerHTML = html;
        dropdown.classList.add('open');

        dropdown.querySelectorAll('.client-option').forEach(function(el) {
          el.addEventListener('mousedown', function(e) {
            e.preventDefault();
            var id = el.getAttribute('data-id');
            hiddenInput.value = id;
            searchInput.value = el.querySelector('.client-name').textContent;
            dropdown.classList.remove('open');
            if (id) populateFromClient(id);
          });
        });
      }

      searchInput.addEventListener('input', function() {
        renderClients(searchInput.value);
      });

      searchInput.addEventListener('focus', function() {
        renderClients(searchInput.value);
      });

      document.addEventListener('click', function(e) {
        if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
          dropdown.classList.remove('open');
        }
      });

      searchInput.addEventListener('keydown', function(e) {
        var active = dropdown.querySelector('.client-option.active');
        var options = Array.prototype.slice.call(dropdown.querySelectorAll('.client-option'));
        var index = options.indexOf(active);
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          var next = options[index + 1];
          if (next) {
            options.forEach(function(o) { o.classList.remove('active'); });
            next.classList.add('active');
          }
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          var prev = options[index - 1];
          if (prev) {
            options.forEach(function(o) { o.classList.remove('active'); });
            prev.classList.add('active');
          }
        } else if (e.key === 'Enter') {
          e.preventDefault();
          if (active) {
            var id = active.getAttribute('data-id');
            hiddenInput.value = id;
            searchInput.value = active.querySelector('.client-name').textContent;
            dropdown.classList.remove('open');
            if (id) populateFromClient(id);
          }
        } else if (e.key === 'Escape') {
          dropdown.classList.remove('open');
        }
      });
    }

    initClientSearch();
  </script>