<p><%= link_to "← Back to Job", job_path(@job), class: "btn" %></p>

<h1>Purchase Order <%= @purchase_order.po_number %></h1>

<div style="background: #f9fafb; padding: 1rem; margin-bottom: 1rem; border-radius: 4px;">
  <p><strong>Job:</strong> <%= link_to @job.job_number, job_path(@job) %> — <%= @job.customer_name %></p>
  <p><strong>Supplier:</strong> <%= @purchase_order.supplier_name %></p>
  <p><strong>Order Date:</strong> <%= @purchase_order.order_date&.strftime("%Y-%m-%d") || "N/A" %></p>
  <p><strong>Status:</strong> <%= @purchase_order.status.present? ? "<span class=\"badge badge-#{@purchase_order.status}\">#{@purchase_order.status.humanize}</span>".html_safe : "Draft" %></p>
  <p><strong>Created By:</strong> <%= @purchase_order.created_by&.name || "N/A" %></p>
</div>

<h3>Line Items</h3>
<table style="width: 100%; margin-bottom: 1rem; border-collapse: collapse;">
  <thead>
    <tr>
      <th style="text-align: left; padding: 0.75rem; border-bottom: 2px solid var(--border);">Description</th>
      <th style="text-align: left; padding: 0.75rem; border-bottom: 2px solid var(--border);">Quantity</th>
      <th style="text-align: left; padding: 0.75rem; border-bottom: 2px solid var(--border);">Unit Price (R)</th>
      <th style="text-align: left; padding: 0.75rem; border-bottom: 2px solid var(--border);">Total (R)</th>
    </tr>
  </thead>
  <tbody>
    <% @purchase_order.items.each do |item| %>
      <tr>
        <td style="padding: 0.75rem; border-bottom: 1px solid var(--border);"><%= item.description %></td>
        <td style="padding: 0.75rem; border-bottom: 1px solid var(--border);"><%= item.quantity %></td>
        <td style="padding: 0.75rem; border-bottom: 1px solid var(--border);">R <%= number_with_precision(item.unit_price, precision: 2) %></td>
        <td style="padding: 0.75rem; border-bottom: 1px solid var(--border);">R <%= number_with_precision(item.total, precision: 2) %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr>
      <td colspan="3" style="text-align: right; padding: 0.75rem; font-weight: 600; color: var(--text-muted);">Subtotal (excl. VAT):</td>
      <td style="padding: 0.75rem; font-weight: 600; color: var(--text-muted);">R <%= number_with_precision(@purchase_order.subtotal, precision: 2) %></td>
    </tr>
    <tr>
      <td colspan="3" style="text-align: right; padding: 0.75rem; font-weight: 600; color: var(--text-muted);">VAT (15%):</td>
      <td style="padding: 0.75rem; font-weight: 600; color: var(--text-muted);">R <%= number_with_precision(@purchase_order.vat_amount, precision: 2) %></td>
    </tr>
    <tr>
      <td colspan="3" style="text-align: right; padding: 0.75rem; font-weight: 700; font-size: 1.05rem; border-top: 2px solid var(--border);">Total (incl. VAT):</td>
      <td style="padding: 0.75rem; font-weight: 700; font-size: 1.05rem; border-top: 2px solid var(--border);">R <%= number_with_precision(@purchase_order.total_including_vat, precision: 2) %></td>
    </tr>
  </tfoot>
</table>

<% if @purchase_order.notes.present? %>
  <h3>Notes</h3>
  <p><%= @purchase_order.notes %></p>
<% end %>

<p style="margin-top: 1rem;">
  <%= link_to "Edit", edit_job_purchase_order_path(@job, @purchase_order), class: "btn" %>
  <%= button_to "Delete", job_purchase_order_path(@job, @purchase_order), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-danger", style: "display: inline;" %>
</p>