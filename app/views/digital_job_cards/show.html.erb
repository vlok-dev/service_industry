<div class="page-header">
  <h1>Digital Job Card</h1>
  <p>View job card details</p>
</div>

<div class="card">
  <div class="card-header">
    <h2><%= @digital_job_card.client_name %></h2>
    <div class="card-header-actions">
      <%= link_to "Print", print_digital_job_card_path(@digital_job_card), class: "btn btn-sm btn-success", target: "_blank" %>
      <%= link_to "Back", digital_job_cards_path, class: "btn btn-sm btn-secondary" %>
    </div>
  </div>
  <div class="card-body">
    <div class="info-grid">
      <div class="info-tile">
        <div class="label">Client Name</div>
        <div class="value"><%= @digital_job_card.client_name %></div>
      </div>
      <div class="info-tile">
        <div class="label">Address</div>
        <div class="value"><%= @digital_job_card.address %></div>
      </div>
      <div class="info-tile">
        <div class="label">Date</div>
        <div class="value"><%= @digital_job_card.date&.strftime("%d %b %Y") %></div>
      </div>
      <div class="info-tile">
        <div class="label">Time Start</div>
        <div class="value"><%= @digital_job_card.time_start&.strftime("%I:%M %p") %></div>
      </div>
      <div class="info-tile">
        <div class="label">Time Finish</div>
        <div class="value"><%= @digital_job_card.time_finish&.strftime("%I:%M %p") %></div>
      </div>
      <div class="info-tile">
        <div class="label">Plumber</div>
        <div class="value"><%= @digital_job_card.user&.name || "—" %></div>
      </div>
      <div class="info-tile">
        <div class="label">Created</div>
        <div class="value"><%= @digital_job_card.created_at.strftime("%d %b %Y %I:%M %p") %></div>
      </div>
    </div>

    <div class="section-card" style="margin-bottom: 1rem;">
      <header>Description</header>
      <div class="body"><%= simple_format(@digital_job_card.description) %></div>
    </div>

    <div class="section-card" style="margin-bottom: 1rem;">
      <header>Materials</header>
      <div class="body">
        <% materials = @digital_job_card.materials.where(is_labor: false) %>
        <% if materials.any? %>
          <table style="width: 100%; border-collapse: collapse; font-size: 0.85rem;">
            <thead>
              <tr style="border-bottom: 1px solid var(--border);">
                <th style="text-align: left; padding: 0.5rem;">Item</th>
                <th style="text-align: left; padding: 0.5rem;">Code</th>
                <th style="text-align: right; padding: 0.5rem;">Qty</th>
                <th style="text-align: right; padding: 0.5rem;">Unit Price</th>
                <th style="text-align: right; padding: 0.5rem;">Markup %</th>
                <th style="text-align: right; padding: 0.5rem;">Total</th>
              </tr>
            </thead>
            <tbody>
              <% materials.each do |m| %>
                <tr style="border-bottom: 1px solid var(--border-light);">
                  <td style="padding: 0.5rem;"><%= m.material_name %></td>
                  <td style="padding: 0.5rem;"><%= m.inventory_item&.code %></td>
                  <td style="text-align: right; padding: 0.5rem;"><%= number_with_precision(m.quantity, precision: 2, strip_insignificant_zeros: true) %></td>
                  <td style="text-align: right; padding: 0.5rem;">R <%= number_with_precision(m.unit_price, precision: 2) %></td>
                  <td style="text-align: right; padding: 0.5rem;"><%= number_with_precision(m.markup, precision: 0, strip_insignificant_zeros: true) %>%</td>
                  <td style="text-align: right; padding: 0.5rem; font-weight: 600;">R <%= number_with_precision(m.total_price, precision: 2) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
          <div style="text-align: right; margin-top: 0.5rem; font-weight: 600;">
            Materials Total: R <%= number_with_precision(materials.sum(&:total_price), precision: 2) %>
          </div>
        <% else %>
          <span style="color: var(--text-muted);">—</span>
        <% end %>
      </div>
    </div>

    <div class="section-card" style="margin-bottom: 0;">
      <header>Labour</header>
      <div class="body">
        <% labor_items = @digital_job_card.materials.where(is_labor: true) %>
        <% if labor_items.any? %>
          <table style="width: 100%; border-collapse: collapse; font-size: 0.85rem;">
            <thead>
              <tr style="border-bottom: 1px solid var(--border);">
                <th style="text-align: left; padding: 0.5rem;">Description</th>
                <th style="text-align: right; padding: 0.5rem;">Rate</th>
                <th style="text-align: right; padding: 0.5rem;">Total</th>
              </tr>
            </thead>
            <tbody>
              <% labor_items.each do |l| %>
                <tr style="border-bottom: 1px solid var(--border-light);">
                  <td style="padding: 0.5rem;"><%= l.material_name %></td>
                  <td style="text-align: right; padding: 0.5rem;">R <%= number_with_precision(l.labor_rate, precision: 2) %></td>
                  <td style="text-align: right; padding: 0.5rem; font-weight: 600;">R <%= number_with_precision(l.total_price, precision: 2) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
          <div style="text-align: right; margin-top: 0.5rem; font-weight: 600;">
            Labour Total: R <%= number_with_precision(labor_items.sum(&:total_price), precision: 2) %>
          </div>
        <% else %>
          <span style="color: var(--text-muted);">—</span>
        <% end %>
      </div>
    </div>

    <div style="margin-top: 1rem; padding: 1rem; background: var(--primary-light); border-radius: var(--radius-sm); text-align: right; font-size: 1.25rem; font-weight: 700; color: var(--primary);">
      Grand Total (Excl. VAT): R <%= number_with_precision(@digital_job_card.materials.sum(&:total_price), precision: 2) %>
    </div>
  </div>
  <div class="card-footer" style="padding: 1rem 1.5rem; border-top: 1px solid var(--border); display: flex; gap: 0.75rem; justify-content: flex-end;">
    <%= link_to "Edit", edit_digital_job_card_path(@digital_job_card), class: "btn btn-sm" %>
    <%= link_to "Delete", digital_job_card_path(@digital_job_card), method: :delete, data: { confirm: "Delete this digital job card?" }, class: "btn btn-sm btn-danger" %>
  </div>
</div>