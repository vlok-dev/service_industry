<div class="material-row" data-index="<%= f.index %>" style="display: flex; gap: 0.5rem; align-items: flex-end; margin-bottom: 0.5rem; flex-wrap: wrap;">
  <%= f.hidden_field :_destroy, value: "false" %>
  <%= f.hidden_field :is_labor, value: f.object.labor? ? "true" : "false" %>

  <div class="field" style="flex: 1; min-width: 200px; margin-bottom: 0;">
    <%= f.label :material_name, f.object.labor? ? "Labour Description" : "Material Name" %><br>
    <%= f.text_field :material_name, placeholder: f.object.labor? ? "e.g. Plumber hours" : "e.g. half inch elbow", required: true %>
  </div>

  <% if f.object.labor? %>
    <div class="field" style="width: 80px; margin-bottom: 0;">
      <%= f.label :hours_worked, "Hours" %><br>
      <%= f.number_field :hours_worked, step: "0.25", min: "0", value: f.object.hours_worked || 1, class: "hours-input", style: "width: 100%;" %>
    </div>

    <div class="field" style="width: 100px; margin-bottom: 0;">
      <%= f.label :labor_rate, "Labour Rate" %><br>
      <%= f.number_field :labor_rate, step: "0.01", min: "0", value: f.object.labor_rate || 0, class: "labor-rate-input", style: "width: 100%;" %>
    </div>
  <% else %>
    <div class="field" style="width: 200px; margin-bottom: 0;">
      <%= f.label :inventory_item_id, "Inventory Item" %><br>
      <div class="inventory-search-wrapper" style="position: relative;">
        <input type="text" class="inventory-search-input" autocomplete="off" placeholder="Search by code or name..." value="<%= f.object.inventory_item ? "#{f.object.inventory_item.code} - #{f.object.inventory_item.name}" : "" %>" style="width: 100%; padding: 0.5rem; border: 1px solid var(--border); border-radius: var(--radius-sm);">
        <%= f.hidden_field :inventory_item_id, data: { inventory_id_target: true } %>
        <div class="inventory-dropdown-results" style="display: none; position: absolute; top: 100%; left: 0; right: 0; background: white; border: 1px solid var(--border); border-radius: var(--radius-sm); max-height: 200px; overflow-y: auto; z-index: 100; box-shadow: var(--shadow-md);"></div>
      </div>
    </div>

    <div class="field" style="width: 80px; margin-bottom: 0;">
      <%= f.label :quantity, "Qty" %><br>
      <%= f.number_field :quantity, step: "0.01", min: "0", value: f.object.quantity.presence || 1, class: "qty-input", style: "width: 100%;" %>
    </div>

    <div class="field" style="width: 100px; margin-bottom: 0;">
      <%= f.label :unit_price, "Unit Price" %><br>
      <%= f.number_field :unit_price, step: "0.01", min: "0", value: f.object.unit_price.presence || 0, class: "unit-price-input", style: "width: 100%;" %>
    </div>

    <div class="field" style="width: 80px; margin-bottom: 0;">
      <%= f.label :markup, "Markup %" %><br>
      <%= f.number_field :markup, step: "1", min: "0", value: f.object.markup.presence || 30, class: "markup-input", style: "width: 100%;" %>
    </div>
  <% end %>

  <div class="field" style="width: 100px; margin-bottom: 0;">
    <%= f.label :total_price, "Total" %><br>
    <div class="line-total" style="padding: 0.5rem; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); font-weight: 600; min-height: 38px; display: flex; align-items: center;">
      <%= format_currency(f.object.total_price) %>
    </div>
  </div>

  <button type="button" class="btn btn-danger btn-sm remove-material" style="height: 38px; padding: 0 0.75rem;" title="Remove">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
  </button>
</div>
