<div class="header">
  <%= image_tag "INDUSTRO-PLUMBERS.png", alt: "Industro Plumbers" %>
  <h1>Extra Work Job Card</h1>
  <p>Job #<%= @digital_job_card.job&.job_number %> | <%= @digital_job_card.date&.strftime("%d %B %Y") %></p>
</div>

<% if @digital_job_card.job %>
  <% content_for :back_link do %>
    <a href="<%= job_path(@digital_job_card.job) %>" class="btn btn-secondary no-print" style="padding: 10px 20px; background: #6b7280; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 600; text-decoration: none;">← Back To Jobs</a>
  <% end %>
<% end %>

<div class="info-grid">
  <div class="info-item">
    <div class="label">Client Name</div>
    <div class="value"><%= @digital_job_card.client_name %></div>
  </div>
  <div class="info-item">
    <div class="label">Date</div>
    <div class="value"><%= @digital_job_card.date&.strftime("%d %B %Y") %></div>
  </div>
  <div class="info-item">
    <div class="label">Time Start</div>
    <div class="value"><%= @digital_job_card.time_start&.strftime("%I:%M %p") %></div>
  </div>
  <div class="info-item">
    <div class="label">Time Finish</div>
    <div class="value"><%= @digital_job_card.time_finish&.strftime("%I:%M %p") %></div>
  </div>
  <div class="info-item" style="grid-column: span 2;">
    <div class="label">Address</div>
    <div class="value"><%= @digital_job_card.address %></div>
  </div>
  <div class="info-item">
    <div class="label">Plumber</div>
    <div class="value"><%= @digital_job_card.user&.name || "—" %></div>
  </div>
  <div class="info-item">
    <div class="label">Created</div>
    <div class="value"><%= @digital_job_card.created_at.strftime("%d %b %Y %I:%M %p") %></div>
  </div>
</div>

<h3 style="color: #1B2C65; border-bottom: 1px solid #ddd; padding-bottom: 5px; margin-bottom: 15px;">Materials</h3>
<% if @materials.any? %>
  <table>
    <thead>
      <tr>
        <th>Item</th>
        <th>Code</th>
        <th>Qty</th>
        <th>Unit Price</th>
        <th>Markup %</th>
        <th>Total</th>
      </tr>
    </thead>
    <tbody>
      <% @materials.each do |m| %>
        <tr>
          <td><%= m.material_name %></td>
          <td><%= m.inventory_item&.code %></td>
          <td><%= number_with_precision(m.quantity, precision: 2, strip_insignificant_zeros: true) %></td>
          <td>R <%= number_with_precision(m.unit_price, precision: 2) %></td>
          <td><%= number_with_precision(m.markup, precision: 0, strip_insignificant_zeros: true) %>%</td>
          <td>R <%= number_with_precision(m.total_price, precision: 2) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p style="color: #999; font-style: italic;">No materials recorded</p>
<% end %>

<h3 style="color: #1B2C65; border-bottom: 1px solid #ddd; padding-bottom: 5px; margin: 20px 0 15px;">Labour</h3>
<% if @labor_items.any? %>
  <table>
    <thead>
      <tr>
        <th>Description</th>
        <th>Rate</th>
        <th>Total</th>
      </tr>
    </thead>
    <tbody>
      <% @labor_items.each do |l| %>
        <tr>
          <td><%= l.material_name %></td>
          <td>R <%= number_with_precision(l.labor_rate, precision: 2) %></td>
          <td>R <%= number_with_precision(l.total_price, precision: 2) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p style="color: #999; font-style: italic;">No labour recorded</p>
<% end %>

<div class="totals">
  <div class="total-row">
    <span>Total Materials:</span>
    <span>R <%= number_with_precision(@total_materials, precision: 2) %></span>
  </div>
  <div class="total-row">
    <span>Total Labour:</span>
    <span>R <%= number_with_precision(@total_labor, precision: 2) %></span>
  </div>
  <div class="total-row grand">
    <span>Grand Total (Excl. VAT):</span>
    <span>R <%= number_with_precision(@grand_total, precision: 2) %></span>
  </div>
</div>

<div class="description-box">
  <h3>Description of Work</h3>
  <p><%= @digital_job_card.description %></p>
</div>

<div class="footer">
  <p>Industro Plumbers - Extra Work Job Card | Generated <%= Time.current.strftime("%d %b %Y %I:%M %p") %></p>
</div>