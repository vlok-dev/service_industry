<div class="page-header">
  <h1>Digital Job Cards</h1>
  <p>Manage your digital job cards</p>
</div>

<div class="action-bar">
     <div class="actions">
       <%= form_with url: digital_job_cards_path, method: :get, local: true, style: "display: flex; gap: 0.5rem; align-items: center;" do |f| %>
         <%= f.text_field :q, value: params[:q], placeholder: "Search by Client Name, Address, or Description...", style: "padding: 0.5rem 0.75rem; border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 0.875rem; width: 320px;" %>
         <%= f.submit "Search", class: "btn" %>
         <% if params[:q].present? %>
           <%= link_to "Clear", digital_job_cards_path, class: "btn btn-sm btn-secondary" %>
         <% end %>
       <% end %>
      <% unless current_user.scheduler? %>
         <%= link_to new_digital_job_card_path, class: "btn btn-success", style: "margin-left: 0.5rem;" do %>
           <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
           Create New Digital Job Card
         <% end %>
     <% end %>
  </div>
</div>

<% if @digital_job_cards.any? %>
  <div class="card">
    <div class="card-body no-padding">
      <div class="modern-table">
        <table>
          <thead>
            <tr>
              <th>Client Name</th>
              <th>Address</th>
              <th>Date</th>
              <th>Time Start</th>
              <th>Time Finish</th>
              <th>Description</th>
              <th>Materials Cost</th>
              <th>Labour Cost</th>
              <th>Total (Excl. VAT)</th>
              <th>Created</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="digital_job_cards_table_body">
            <% @digital_job_cards.each do |card| %>
              <tr>
                <td><%= card.client_name %></td>
                <td><%= card.address&.truncate(50) %></td>
                <td><%= card.date&.strftime("%d %b %Y") %></td>
                <td><%= card.time_start&.strftime("%I:%M %p") %></td>
                <td><%= card.time_finish&.strftime("%I:%M %p") %></td>
                <td><%= card.description&.truncate(60) %></td>
                <td><%= format_currency(card.materials_total) %></td>
                <td><%= format_currency(card.labor_total) %></td>
                <td><strong><%= format_currency(card.grand_total) %></strong></td>
                <td><%= card.created_at.strftime("%d %b %Y %I:%M %p") %></td>
                <td>
                  <div class="actions-icon">
                    <%= link_to digital_job_card_path(card), class: "btn-icon btn-icon-primary", title: "View" do %>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    <% end %>
                    <%= link_to print_digital_job_card_path(card), class: "btn-icon btn-icon-success", title: "Print", target: "_blank" do %>
                      Print
                    <% end %>
                    <%= link_to edit_digital_job_card_path(card), class: "btn-icon btn-icon-edit", title: "Edit" do %>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                      <% end %>
                    <% unless current_user.scheduler? %>
                      <%= button_to digital_job_card_path(card), method: :delete, data: { confirm: "Delete this digital job card?" }, class: "btn-icon btn-icon-danger", title: "Delete" do %>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if @pagy.pages > 1 %>
        <div class="pagination-nav" style="padding: 1rem; display: flex; justify-content: center; gap: 0.5rem; flex-wrap: wrap;">
          <%== @pagy.series_nav %>
        </div>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="card">
    <div class="card-body">
      <div class="empty-state">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><path d="M8 21h8"></path><path d="M12 17v4"></path></svg>
        <p>No digital job cards yet. Click "Create New Digital Job Card" to get started.</p>
      </div>
    </div>
  </div>
<% end %>

  <div id="flash"></div>
