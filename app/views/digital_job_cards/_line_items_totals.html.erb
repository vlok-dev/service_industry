<div id="totals-summary" style="background: var(--bg); padding: 1rem; border-radius: var(--radius-sm); margin-top: 1rem; border: 1px solid var(--border);">
  <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; text-align: center;">
    <div>
      <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Materials Cost</div>
      <div id="total-materials" style="font-size: 1.5rem; font-weight: 700; color: var(--text);">R 0.00</div>
    </div>
    <div>
      <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Labour Cost</div>
      <div id="total-labor" style="font-size: 1.5rem; font-weight: 700; color: var(--text);">R 0.00</div>
    </div>
    <div>
      <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Total (Excl. VAT)</div>
      <div id="grand-total" style="font-size: 1.5rem; font-weight: 700; color: var(--primary);">R 0.00</div>
    </div>
  </div>
</div>
