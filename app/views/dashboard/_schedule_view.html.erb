<div class="card" id="schedule_view" style="margin-top: 1.5rem; scroll-margin-top: 1rem;">
  <div class="card-header">
    <h2 id="schedule-range-label"><%= @date_range_label %></h2>
    <div class="view-tabs">
      <%= link_to "Day", dashboard_path(view: "day", date: @scheduler_date, anchor: "schedule_view"), class: "view-tab #{@scheduler_view == 'day' ? 'active' : ''}" %>
      <%= link_to "Week", dashboard_path(view: "week", date: @scheduler_date, anchor: "schedule_view"), class: "view-tab #{@scheduler_view == 'week' ? 'active' : ''}" %>
      <%= link_to "Month", dashboard_path(view: "month", date: @scheduler_date, anchor: "schedule_view"), class: "view-tab #{@scheduler_view == 'month' ? 'active' : ''}" %>
    </div>
    <% if current_user.scheduler? || current_user.super_admin? %>
      <button type="button" class="btn btn-sm btn-print-jobs" id="dashboardPrintJobsBtn">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7"></path><path d="M6 18h12v6H6v-6z"></path><polyline points="6 9 6 5"></polyline></svg>
        Print Jobs
      </button>
    <% end %>
  </div>
  <div class="card-body" style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between;">
    <div class="date-navigation">
      <%= link_to "&#9664; Prev".html_safe, dashboard_path(view: @scheduler_view, date: prev_date, anchor: "schedule_view"), class: "btn btn-sm btn-secondary" %>
      <%= form_with url: dashboard_path(anchor: "schedule_view"), method: :get, data: { turbo_frame: "_top" }, style: "display: flex; align-items: center; gap: 0.5rem;" do |f| %>
        <%= f.hidden_field :view, value: @scheduler_view %>
        <%= f.date_field :date, value: @scheduler_date, onchange: "this.form.requestSubmit();", class: "date-picker" %>
      <% end %>
      <%= link_to "Next &#9654;".html_safe, dashboard_path(view: @scheduler_view, date: next_date, anchor: "schedule_view"), class: "btn btn-sm btn-secondary" %>
    </div>
  </div>
  <div class="card-body no-padding">
    <% if @scheduled_jobs.present? %>
      <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th><%= sortable_header "Date", "scheduled_date" %></th>
            <th><%= sortable_header "Time", "scheduled_time" %></th>
            <th><%= sortable_header "Customer", "customer_name" %></th>
            <th><%= sortable_header "Problem", "description" %></th>
            <th><%= sortable_header "Address", "address" %></th>
            <th><%= sortable_header "Plumber", "assigned_to" %></th>
            <th><%= sortable_header "Status", "status" %></th>
            <th><%= sortable_header "Job Type", "is_project" %></th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <%# Grouped by day so each day can carry its own bulk-send button.
              In the Day view there is exactly one group, which is the common
              case; in Week/Month views the same rows simply split by date. %>
          <% jobs_by_day = @scheduled_jobs.group_by { |job| job.scheduled_date }.sort_by { |date, _| date || Date.new(9999, 12, 31) } %>
          <% jobs_by_day.each do |day, jobs| %>
            <% day_pending = jobs.count { |job| job_whatsapp_sendable?(job) } %>
            <tr style="background: var(--bg-subtle, #f8fafc);">
              <td colspan="9" style="padding: 0.5rem 0.75rem;">
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
                  <strong><%= day ? day.strftime("%A, %d %B %Y") : "Unscheduled" %></strong>
                  <% if day_pending.positive? && (current_user.scheduler? || current_user.super_admin?) %>
                    <%= link_to bulk_whatsapp_jobs_path(scheduled_date: day&.iso8601),
                                class: "btn btn-sm btn-success",
                                data: { turbo: false },
                                title: "Send WhatsApp to each plumber for this day, one message at a time" do %>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8z"></path></svg>
                      Send Bulk WhatsApps (<%= day_pending %>)
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
            <% jobs.each do |job| %>
              <tr data-job-id="<%= job.id %>">
                <td data-label="Date"><%= date_columns_display(job.scheduled_date) %></td>
                <td data-label="Time"><%= job.scheduled_time&.strftime("%I:%M %p")&.strip || "—" %></td>
                <td data-label="Customer"><%= job.customer_name %></td>
                <td data-label="Problem"><%= job.description.to_s.truncate(50) %></td>
                <td data-label="Address"><%= job.address.truncate(40) %></td>
                <td data-label="Plumber"><%= render "assigned_to_dropdown", job: job %></td>
                <td data-label="Status"><%= render "status_dropdown", job: job %></td>
                <td data-label="Job Type"><%= render "job_type_dropdown", job: job %></td>
                <td data-label="Actions">
                  <button type="button" class="row-colour-btn" title="Row Colour">Row Colour</button>
                  <span id="whatsapp-cell-<%= job.id %>">
                    <% if job.whatsapp_sent_at %>
                      Sent WhatsApp on <%= whatsapp_sent_at_display(job) %>
                    <% elsif job_whatsapp_recipient(job).present? %>
                      <%= link_to "Send WhatsApp", "#", class: "btn btn-sm whatsapp-confirm-btn", data: { job_id: job.id } %>
                    <% else %>
                      <span style="font-size: 0.8rem; color: var(--text-muted);" title="Assign a plumber with a phone number to send WhatsApp">No plumber number</span>
                    <% end %>
                  </span>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
      </div>
    <% else %>
      <div class="empty-state">No jobs scheduled for this period.</div>
    <% end %>
  </div>
</div>
