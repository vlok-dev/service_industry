<div class="card" id="schedule_view" style="margin-top: 1.5rem; scroll-margin-top: 1rem;">
  <div class="card-header">
    <h2 id="schedule-range-label"><%= @date_range_label %></h2>
    <div class="view-tabs">
      <%= link_to "Day", dashboard_path(view: "day", date: @scheduler_date, anchor: "schedule_view"), class: "view-tab #{@scheduler_view == 'day' ? 'active' : ''}" %>
      <%= link_to "Week", dashboard_path(view: "week", date: @scheduler_date, anchor: "schedule_view"), class: "view-tab #{@scheduler_view == 'week' ? 'active' : ''}" %>
      <%= link_to "Month", dashboard_path(view: "month", date: @scheduler_date, anchor: "schedule_view"), class: "view-tab #{@scheduler_view == 'month' ? 'active' : ''}" %>
    </div>
  </div>
  <div class="card-body" style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between;">
    <div class="date-navigation">
      <%= link_to "&#9664; Prev".html_safe, dashboard_path(view: @scheduler_view, date: prev_date, anchor: "schedule_view"), class: "btn btn-sm btn-secondary" %>
      <%= form_with url: dashboard_path(anchor: "schedule_view"), method: :get, data: { turbo_frame: "_top" }, style: "display: flex; align-items: center; gap: 0.5rem;" do |f| %>
        <%= f.hidden_field :view, value: @scheduler_view %>
        <%= f.date_field :date, value: @scheduler_date, onchange: "this.form.requestSubmit();", class: "date-picker" %>
      <% end %>
      <%= link_to "Next &#9654;".html_safe, dashboard_path(view: @scheduler_view, date: next_date, anchor: "schedule_view"), class: "btn btn-sm btn-secondary" %>
    </div>
  </div>
  <div class="card-body no-padding">
    <% if @scheduled_jobs.present? %>
      <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Date</th>
            <th>Time</th>
            <th>Customer</th>
            <th>Address</th>
            <th>Plumber</th>
            <th>Job Type</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @scheduled_jobs.order(:scheduled_date, :scheduled_time).each do |job| %>
            <tr>
              <td data-label="Date"><%= job.scheduled_date&.strftime("%b %d, %Y") || "—" %></td>
              <td data-label="Time"><%= job.scheduled_time&.strftime("%I:%M %p")&.strip || "—" %></td>
              <td data-label="Customer"><%= job.customer_name %></td>
              <td data-label="Address"><%= job.address.truncate(40) %></td>
              <td data-label="Plumber"><%= job.assigned_to&.name || "Unassigned" %></td>
              <td data-label="Job Type"><%= render "job_type_dropdown", job: job %></td>
              <td data-label="Actions">
                <span id="whatsapp-cell-<%= job.id %>">
                  <% if job.whatsapp_sent_at %>
                    Sent WhatsApp on <%= (job.whatsapp_sent_at + 2.hours).strftime('%d %b %Y') %> at <%= (job.whatsapp_sent_at + 2.hours).strftime('%I:%M %p') %>
                  <% else %>
                    <%= link_to "Send WhatsApp", "#", class: "btn btn-sm whatsapp-confirm-btn", data: { job_id: job.id } %>
                  <% end %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      </div>
    <% else %>
      <div class="empty-state">No jobs scheduled for this period.</div>
    <% end %>
  </div>
</div>