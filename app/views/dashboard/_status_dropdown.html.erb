<div id="job-<%= job.id %>-status">
  <% if policy(job).update_status? %>
    <%
      badge_colors = {
        "pending"     => { bg: "#fef3c7", fg: "#92400e" },
        "scheduled"   => { bg: "#dbeafe", fg: "#1e40af" },
        "in_progress" => { bg: "#ede9fe", fg: "#6d28d9" },
        "completed"   => { bg: "#d1fae5", fg: "#065f46" },
        "cancelled"   => { bg: "#fee2e2", fg: "#991b1b" },
        "invoiced"    => { bg: "#cffafe", fg: "#0e7490" }
      }
      status_key = job.display_status_key
      colors = badge_colors[status_key] || { bg: "#fef3c7", fg: "#92400e" }
      status_options = Job.statuses.keys.flat_map do |status|
        if status == "completed" && job.invoiced?
          [
            ["Invoiced", "invoiced", { style: "background: #{badge_colors["invoiced"][:bg]}; color: #{badge_colors["invoiced"][:fg]}; font-weight: 600;" }],
            ["Completed", status, { style: "background: #{badge_colors[status][:bg]}; color: #{badge_colors[status][:fg]}; font-weight: 600;" }]
          ]
        else
          [[status.humanize, status, { style: "background: #{badge_colors[status][:bg]}; color: #{badge_colors[status][:fg]}; font-weight: 600;" }]]
        end
      end
    %>
    <%= form_with url: update_status_job_path(job), method: :patch, style: "display: inline;" do |f| %>
      <%= f.select :status, status_options, { include_blank: false, selected: status_key }, { onchange: "this.form.requestSubmit();", style: "padding: 0.25rem 0.4rem; border: none; border-radius: 6px; font-size: 0.8rem; background: #{colors[:bg]}; color: #{colors[:fg]}; cursor: pointer; font-weight: 600;" } %>
    <% end %>
  <% else %>
    <span class="badge badge-<%= job.display_status_key %>"><%= job.display_status %></span>
  <% end %>
</div>
