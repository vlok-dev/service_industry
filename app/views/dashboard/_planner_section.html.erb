<div class="section-title" style="margin-top: 2rem;">
    Planner - Non-Job Entries
    <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: 400; margin-left: 0.5rem;">Medicals, car services, meetings, admin, training</span>
    <span style="margin-left: auto;">
      <%= link_to "View All", planner_entries_path, class: "btn btn-sm btn-secondary" %>
      <%= link_to "+ New Entry", new_planner_entry_path, class: "btn btn-sm" %>
    </span>
  </div>

  <% if @planner_entries.present? %>
    <div class="planner-grid">
      <% @planner_entries.each do |entry| %>
        <div class="planner-card" style="border-left: 4px solid <%= entry.category_color %>;">
          <div class="planner-card-header">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <span class="planner-icon"><%= entry.category_icon %></span>
              <span class="planner-category" style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: <%= entry.category_color %>;"><%= entry.category.to_s.humanize %></span>
            </div>
            <span class="badge badge-<%= entry.status %>"><%= entry.status.to_s.humanize %></span>
          </div>
          <div class="planner-card-body">
            <h3 class="planner-title"><%= entry.title %></h3>
            <% if entry.description.present? %>
              <p class="planner-desc"><%= entry.description %></p>
            <% end %>
            <div class="planner-meta">
              <span>📅 <%= entry.entry_date.strftime("%d %b %Y") %></span>
              <% if entry.entry_time.present? %>
                <span>⏰ <%= entry.entry_time.strftime("%I:%M %p") %></span>
              <% end %>
              <% if entry.assigned_to %>
                <span>👤 <%= entry.assigned_to.name %></span>
              <% end %>
            </div>
          </div>
          <div class="planner-card-footer">
            <%= link_to edit_planner_entry_path(entry), class: "btn-icon", title: "Edit" do %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
            <% end %>
            <%= link_to planner_entry_path(entry), class: "btn-icon btn-icon-primary", title: "View" do %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
            <% end %>
            <% if (current_user.scheduler? || current_user.super_admin?) && entry.assigned_to&.phone_number.present? %>
              <%= link_to whatsapp_planner_entry_path(entry), class: "btn-icon btn-icon-success", title: "Send WhatsApp", data: { turbo: false } do %>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#25D366" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8z"></path></svg>
              <% end %>
            <% end %>
            <%= button_to planner_entry_path(entry), method: :delete, data: { confirm: "Are you sure?" }, class: "btn-icon btn-icon-danger", title: "Delete" do %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="card" style="margin-top: 1rem;">
      <div class="card-body" style="text-align: center; padding: 2rem;">
        <div style="font-size: 2rem; margin-bottom: 0.5rem;">📋</div>
        <p style="color: var(--text-muted); margin-bottom: 1rem;">No planner entries yet. Add medicals, car services, meetings, admin tasks, or training.</p>
        <%= link_to "Create First Entry", new_planner_entry_path, class: "btn" %>
      </div>
    </div>
  <% end %>