<% if @show_reminder %>
<div class="modal-overlay" id="reminderModal" style="z-index: 10001; display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); align-items: center; justify-content: center; padding: 2rem;">
  <div class="modal-dialog" style="background: white; border-radius: 20px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); max-width: 480px; width: 100%; overflow: hidden;">
    <div style="background: linear-gradient(135deg, #1b2c65 0%, #2563eb 100%); padding: 1.5rem; color: white; position: relative;">
      <div style="position: absolute; right: -30px; top: -30px; width: 100px; height: 100px; border-radius: 50%; background: rgba(178, 211, 62, 0.3);"></div>
      <div style="position: relative; z-index: 1;">
        <div style="font-size: 2rem; margin-bottom: 0.5rem;">🔔</div>
        <h3 style="margin: 0; font-size: 1.25rem; font-weight: 700;">Upcoming Reminders</h3>
        <p style="margin: 0.25rem 0 0; font-size: 0.85rem; opacity: 0.9;">My <%= pluralize(@reminders.count, "event") %> coming up</p>
        <div style="margin-top: 0.75rem; background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.25); border-radius: 10px; padding: 0.6rem 0.8rem; font-size: 0.8rem; line-height: 1.5;">
          ℹ️ <strong>How reminders work:</strong> This reminder shows once a day for the 3 days before the event. Press <strong>"Dismiss For Today"</strong> to hide it for today only — it returns tomorrow. The final reminder appears the day before.
        </div>
      </div>
    </div>
    <div style="padding: 1.25rem 1.5rem; max-height: 400px; overflow-y: auto;">
      <% @reminders.each do |entry| %>
        <% is_last_day = entry.entry_date - 1.day == Date.today %>
        <div style="display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.75rem; border-radius: 12px; background: <%= is_last_day ? '#fef3c7' : '#f8fafc' %>; margin-bottom: 0.75rem; border-left: 4px solid <%= entry.category_color %>; <%= is_last_day ? 'border: 2px solid red;' : '' %>">
          <span style="font-size: 1.25rem;"><%= entry.category_icon %></span>
          <div style="flex: 1;">
            <div style="font-weight: 600; color: #0f172a; font-size: 1.6rem;"><%= entry.title %></div>            
            <% if entry.description.present? %>
              <div style="color: #0f172a; font-size: 1.4rem; margin-top: 0.15rem;"><%= entry.description.truncate(80) %></div>
            <% end %>
            <% if is_last_day %>
              <div style="color: #b45309; font-size: 0.65rem; font-weight: 600; margin-top: 0.60rem;">⚠️REMINDER FOR TOMORROW⚠️</div>
              <div style="color: #b45309; font-size: 0.60rem; font-weight: 600; margin-top: 0.25rem; font-style: italic;">⚠️This is the final day the reminder will show.⚠️</div>
            <% end %>
            <div style="display: flex; gap: 0.75rem; margin-top: 0.35rem; font-size: 0.75rem; color: #64748b;">
              <span>📅 Date: <%= entry.entry_date.strftime("%d %b %Y") %></span>
              <% if entry.entry_time.present? %>
                <span>⏰ Time: <%= entry.entry_time.strftime("%I:%M %p") %></span>
              <% end %>
              <% if entry.assigned_to %>
                <span>👤 For: <%= entry.assigned_to.name %></span>
              <% end %>
            </div>
          </div>
          <%= button_to "Dismiss For Today", dismiss_reminder_dashboard_path(entry_ids: [entry.id]), method: :patch, class: "btn btn-sm", style: "background: #DC143C; color: #fff; border: 2px solid #B71C1C; padding: 0.5rem 1rem; border-radius: 10px; font-size: 0.9rem; font-weight: 700; cursor: pointer; white-space: nowrap; min-width: 160px; box-shadow: 0 2px 6px rgba\(220,20,60,0.4\);" %>
        </div>
      <% end %>
    </div>
    <div style="padding: 1rem 1.5rem; border-top: 1px solid #e2e8f0; display: flex; gap: 0.75rem; justify-content: flex-end;">
      <a href="<%= planner_entries_path %>" class="btn" style="background: linear-gradient(135deg, #1b2c65, #2563eb); color: white; padding: 0.5rem 1.25rem; border-radius: 10px; font-size: 0.875rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.375rem;">
        View Planner
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </a>
    </div>
  </div>
</div>
<% end %>

<script>
  (function() {
    var modal = document.getElementById('reminderModal');
    if (!modal) return;

    function show() { modal.style.display = 'flex'; }
    function hide() { modal.style.display = 'none'; }

    show();

    modal.addEventListener('click', function(e) {
      if (e.target === modal) hide();
    });

    document.addEventListener('turbo:render', function() {
      var m = document.getElementById('reminderModal');
      if (m && m.style.display === 'none') { m.style.display = 'flex'; }
    });
  })();
</script>

