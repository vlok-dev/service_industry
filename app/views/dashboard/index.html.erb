                    <%= button_tag "Row Colour", type: "button", class: "row-colour-btn btn btn-sm btn-outline", title: "Highlight this row" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        </div>
        <div style="padding: 1rem 1.5rem; background: var(--bg); font-size: 0.875rem; color: var(--text-muted);">
          Total jobs today: <strong><%= @today_jobs.count %></strong>
        </div>
      <% else %>
        <div class="empty-state">No jobs logged today.</div>
      <% end %>
    </div>
  </div>

  <h3 class="section-title">All Jobs</h3>
  <div class="card">
    <div class="card-body no-padding">
      <% if @all_jobs.present? %>
        <div class="modern-table" style="border: none; box-shadow: none; border-radius: 0;">
        <table>
          <thead>
            <tr>
              <th><%= sortable_header "Job #", "job_number" %></th>
              <th><%= sortable_header "Date", "scheduled_date" %></th>
              <th><%= sortable_header "Created", "created_at" %></th>
              <th><%= sortable_header "Customer", "customer_name" %></th>
              <th><%= sortable_header "Address", "address" %></th>
              <th><%= sortable_header "Status", "status" %></th>
              <th><%= sortable_header "Job Type", "is_project" %></th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% @all_jobs.each do |job| %>
              <tr data-job-id="<%= job.id %>">
                <td><%= link_to (job.job_number || "N/A"), job_path(job), style: "color: var(--primary); text-decoration: none; font-weight: 600;", title: "View job and purchase orders" %></td>
                <td><%= date_columns_display(job.scheduled_date) %></td>
                <td><%= job.created_at.strftime("%Y-%m-%d") %></td>
                <td><%= job.customer_name %></td>
                <td><%= job.address.truncate(40) %></td>
                <td><%= render "status_dropdown", job: job %></td>
                <td><%= render "job_type_dropdown", job: job %></td>
                <td>
                  <div class="actions-icon">
                    <%= link_to "Add PO", new_job_purchase_order_path(job), class: "btn btn-sm" %>
                    <%= button_tag "Row Colour", type: "button", class: "row-colour-btn btn btn-sm btn-outline", title: "Highlight this row" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        </div>
      <% else %>
        <div class="empty-state">No jobs in system.</div>
      <% end %>
    </div>
  </div>
<% end %>

<% if current_user.plumber? %>
  <div class="page-header">
    <h2>My Jobs</h2>
    <p>Jobs assigned to you and their current status.</p>
  </div>

  <div class="stats-grid">
    <div class="stat-card stat-pending">
      <span class="stat-value"><%= @pending_jobs.count %></span>
      <span class="stat-label">Pending</span>
    </div>
    <div class="stat-card stat-in-progress">
      <span class="stat-value"><%= @in_progress_jobs.count %></span>
      <span class="stat-label">In Progress</span>
    </div>
    <div class="stat-card stat-completed">
      <span class="stat-value"><%= @completed_jobs.count %></span>
      <span class="stat-label">Completed</span>
    </div>
    <div class="stat-card stat-invoiced">
      <span class="stat-value"><%= @dashboard_counts[:invoiced] %></span>
      <span class="stat-label">Invoiced</span>
    </div>
  </div>

  <% if @my_jobs.present? %>
    <div class="card">
      <div class="card-body no-padding">
        <div class="modern-table" style="border: none; box-shadow: none; border-radius: 0;">
        <table>
          <thead>
            <tr>
              <th><%= sortable_header "Customer", "customer_name" %></th>
              <th><%= sortable_header "Address", "address" %></th>
              <th><%= sortable_header "Date", "scheduled_date" %></th>
              <th><%= sortable_header "Time", "scheduled_time" %></th>
              <th><%= sortable_header "Type", "is_project" %></th>
              <th><%= sortable_header "Status", "status" %></th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @my_jobs.each do |job| %>
              <tr data-job-id="<%= job.id %>">
                <td><%= job.customer_name %>
                  <span class="row-highlight-trigger" title="Highlight row" style="float: right; display: block; margin-top: 0.25rem;">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.5;"><path d="M2.5 14.5c.5.5 1 .75 1.5 1"></path><path d="M2 17l3 3 4-4"></path></svg>
                  </span>
                </td>
                <td><%= job.address.truncate(40) %></td>
                <td><%= date_columns_display(job.scheduled_date) %></td>
                <td><%= (job.scheduled_time&.strftime("%I:%M %p")&.strip || "TBD") %></td>
                <td><%= render "job_type_dropdown", job: job %></td>
                <td><%= render "status_dropdown", job: job %></td>
                <td>
                  <div class="actions-icon">
                    <%= link_to "Update Status", edit_job_path(job), class: "btn btn-sm" %>
                    <%= button_tag "Row Colour", type: "button", class: "row-colour-btn btn btn-sm btn-outline", title: "Highlight this row" %>
                    <% if job.whatsapp_sent_at %>
                      <span style="font-size: 0.8rem; color: var(--text-muted);">Sent WhatsApp on <%= (job.whatsapp_sent_at + 2.hours).strftime('%d %b %Y') %> at <%= (job.whatsapp_sent_at + 2.hours).strftime('%I:%M %p') %></span>
                    <% else %>
                      <%= link_to "WhatsApp", whatsapp_job_path(job), class: "btn btn-sm btn-success", data: { confirm: "Open WhatsApp to send address to customer?" } %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        </div>
      </div>
    </div>
  <% else %>
    <div class="card">
      <div class="card-body">
        <div class="empty-state">No jobs assigned to you. Check back later or contact the scheduler.</div>
      </div>
    </div>
  <% end %>
<% end %>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.btn-schedule-toggle').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var jobId = btn.getAttribute('data-job-id');
          var row = document.getElementById('schedule-row-' + jobId);
          if (row) {
            row.style.display = row.style.display === 'none' ? 'table-row' : 'none';
          }
        });
      });

      document.querySelectorAll('.btn-cancel-schedule').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var jobId = btn.getAttribute('data-job-id');
          var row = document.getElementById('schedule-row-' + jobId);
          if (row) {
            row.style.display = 'none';
          }
        });
      });
});

  </script>

  <div class="modal-overlay" id="printJobsModal" style="z-index: 10000; display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; padding: 2rem;">
    <div class="modal-dialog print-jobs-modal-content" style="background: white; border-radius: 12px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1); max-width: 420px; width: 100%; overflow: hidden;">
      <div class="modal-header" style="padding: 1.25rem 1.5rem; border-bottom: 1px solid #e2e8f0;">
        <h3 style="margin: 0; font-size: 1.125rem; font-weight: 600; color: #0f172a;">Print Jobs</h3>
      </div>
      <div class="modal-body" style="padding: 1.5rem; color: #64748b; font-size: 0.95rem; line-height: 1.6;">
        <p style="margin: 0 0 1rem 0;">Select a date to print scheduled jobs for that day:</p>
        <div class="field" style="margin-bottom: 0;">
          <label for="printJobsDate" style="display: block; margin-bottom: 0.5rem; font-weight: 500; color: #0f172a; font-size: 0.875rem;">Date</label>
          <input type="date" id="printJobsDate" value="<%= Date.tomorrow.strftime('%Y-%m-%d') %>" style="width: 100%; padding: 0.625rem 0.875rem; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 0.9rem; background: white;">
        </div>
      </div>
      <div class="modal-footer" style="padding: 1rem 1.5rem; border-top: 1px solid #e2e8f0; display: flex; gap: 0.75rem; justify-content: flex-end;">
        <button type="button" class="btn btn-secondary" id="printJobsCancel" style="background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; padding: 0.5rem 1rem; border-radius: 8px; font-size: 0.875rem; font-weight: 600; cursor: pointer;">Cancel</button>
        <button type="button" class="btn btn-success" id="printJobsConfirm" style="background: #84cc16; color: #1b2c65; border: none; padding: 0.5rem 1rem; border-radius: 8px; font-size: 0.875rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 0.375rem;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7"></path><path d="M6 18h12v6H6v-6z"></path></svg>
          Print
        </button>
      </div>
    </div>
  </div>

  <script>
    (function() {
      var modal = document.getElementById('printJobsModal');
      if (!modal) return;

      function show() { modal.style.display = 'flex'; }
      function hide() { modal.style.display = 'none'; }

      document.addEventListener('click', function(e) {
        var btn = e.target.closest('#dashboardPrintJobsBtn');
        if (btn) { e.preventDefault(); show(); }

        if (e.target.id === 'printJobsCancel') hide();

        var confirmBtn = e.target.closest('#printJobsConfirm');
        if (confirmBtn) {
          e.preventDefault();
          var dateInput = document.getElementById('printJobsDate');
          var date = dateInput ? dateInput.value : '';
          hide();
          if (date) {
            window.open('<%= print_tomorrow_jobs_path %>' + '?scheduled_date=' + date, '_blank');
          }
        }

if (e.target === modal) hide();
      });
    })();
  </script>
