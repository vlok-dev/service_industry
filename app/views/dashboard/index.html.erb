<h1>Dashboard</h1>

<% if current_user.super_admin? %>
  <h2>My Jobs (Michelle)</h2>
  <p><%= link_to "Create New Job", new_job_path, class: "btn" %></p>
  <%= form_with url: root_path, method: :get, local: true, style: "margin-bottom: 1rem;" do |f| %>
    <%= f.text_field :q, value: params[:q], placeholder: "Search by Job Number, Address, or Invoice Number...", style: "padding: 0.5rem; width: 400px; max-width: 100%;" %>
    <%= f.submit "Search", class: "btn" %>
    <% if params[:q].present? %>
      <%= link_to "Clear", root_path, class: "btn" %>
    <% end %>
  <% end %>
  <% if @my_jobs.present? %>
    <table>
      <thead>
        <tr>
          <th>Job #</th>
          <th>Customer</th>
          <th>Address</th>
          <th>Status</th>
          <th>Scheduled Date</th>
          <th>Assigned To</th>
          <th>Invoice #</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @my_jobs.each do |job| %>
          <tr>
            <td><%= job.job_number || "N/A" %></td>
            <td><%= job.customer_name %></td>
            <td><%= job.address %></td>
            <td>
              <% if job.completed_with_invoice? %>
                <span class="badge badge-completed">INV: <%= job.invoice_number %></span>
              <% else %>
                <span class="badge badge-<%= job.status %>"><%= job.status.humanize %></span>
              <% end %>
            </td>
            <td><%= job.scheduled_date&.strftime("%Y-%m-%d") || "Not scheduled" %></td>
            <td><%= job.assigned_to&.name || "Unassigned" %></td>
            <td><%= job.invoice_number || "—" %></td>
            <td>
              <%= link_to "View", job %>
              <%= link_to "Edit", edit_job_path(job) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No jobs yet.</p>
  <% end %>
<% end %>

<% if current_user.scheduler? %>
  <h2>Pending Jobs (Michael)</h2>
  <% if @pending_jobs.present? %>
    <table>
      <thead>
        <tr>
          <th>Customer</th>
          <th>Address</th>
          <th>Description</th>
          <th>Priority</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @pending_jobs.each do |job| %>
          <tr>
            <td><%= job.customer_name %></td>
            <td><%= job.address %></td>
            <td><%= job.description.truncate(50) %></td>
            <td><%= job.priority.humanize %></td>
            <td>
              <%= form_with url: schedule_job_path(job), method: :patch, local: true do |f| %>
                <%= f.hidden_field :status, value: "scheduled" %>
                <%= f.date_field :scheduled_date, value: @scheduler_date, required: true %>
                <%= f.time_field :scheduled_time, value: "08:00", required: true %>
                <%= f.select :assigned_to_id, options_from_collection_for_select(User.plumber, :id, :name, job.assigned_to_id), include_blank: "Select Plumber" %>
                <%= f.submit "Schedule", class: "btn btn-success" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No pending jobs.</p>
  <% end %>

  <div class="scheduler-controls">
    <div class="view-tabs">
      <%= link_to "Day", dashboard_path(view: "day", date: @scheduler_date), class: "view-tab #{@scheduler_view == 'day' ? 'active' : ''}" %>
      <%= link_to "Week", dashboard_path(view: "week", date: @scheduler_date), class: "view-tab #{@scheduler_view == 'week' ? 'active' : ''}" %>
      <%= link_to "Month", dashboard_path(view: "month", date: @scheduler_date), class: "view-tab #{@scheduler_view == 'month' ? 'active' : ''}" %>
    </div>
    <div class="date-navigation">
      <%= link_to "&#9664; Prev".html_safe, dashboard_path(view: @scheduler_view, date: prev_date), class: "btn btn-secondary" %>
      <%= form_with url: dashboard_path, method: :get, local: true, style: "display: inline;" do |f| %>
        <%= f.hidden_field :view, value: @scheduler_view %>
        <%= f.date_field :date, value: @scheduler_date, onchange: "this.form.submit();", class: "date-picker" %>
      <% end %>
      <%= link_to "Next &#9654;".html_safe, dashboard_path(view: @scheduler_view, date: next_date), class: "btn btn-secondary" %>
    </div>
    <div class="date-display">
      <h2><%= @date_range_label %></h2>
    </div>
  </div>

  <% if @scheduled_jobs.present? %>
    <table>
      <thead>
        <tr>
          <th>Time</th>
          <th>Customer</th>
          <th>Address</th>
          <th>Plumber</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @scheduled_jobs.order(:scheduled_date, :scheduled_time).each do |job| %>
          <tr>
            <td><%= job.scheduled_time&.strftime("%H:%M") %></td>
            <td><%= job.customer_name %></td>
            <td><%= job.address %></td>
            <td><%= job.assigned_to&.name || "Unassigned" %></td>
            <td>
              <%= link_to "Send WhatsApp to Plumber", whatsapp_job_path(job), class: "btn", data: { confirm: "Open WhatsApp to send job details to plumber?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @scheduler_view == "day" %>
      <%= link_to "Send All #{@scheduler_date.strftime('%A')}'s Jobs via WhatsApp", bulk_whatsapp_jobs_path(scheduled_date: @scheduler_date), class: "btn btn-success" %>
    <% end %>
  <% else %>
    <p>No jobs scheduled for this period.</p>
  <% end %>
<% end %>

<% if current_user.reporter? %>
  <h2>Daily Report - <%= Date.today.strftime("%B %d, %Y") %> (Lee Anne)</h2>
  <h3>Today's Jobs</h3>
  <% if @today_jobs.present? %>
    <table>
      <thead>
        <tr>
          <th>Time Logged</th>
          <th>Customer</th>
          <th>Address</th>
          <th>Description</th>
          <th>Logged By</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% @today_jobs.each do |job| %>
          <tr>
            <td><%= job.created_at.strftime("%H:%M") %></td>
            <td><%= job.customer_name %></td>
            <td><%= job.address %></td>
            <td><%= job.description.truncate(50) %></td>
            <td><%= job.user.name %></td>
            <td><span class="badge badge-<%= job.status %>"><%= job.status.humanize %></span></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <p>Total jobs today: <%= @today_jobs.count %></p>
  <% else %>
    <p>No jobs logged today.</p>
  <% end %>

  <h3>All Jobs</h3>
  <% if @all_jobs.present? %>
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Customer</th>
          <th>Address</th>
          <th>Status</th>
          <th>Logged By</th>
        </tr>
      </thead>
      <tbody>
        <% @all_jobs.each do |job| %>
          <tr>
            <td><%= job.created_at.strftime("%Y-%m-%d") %></td>
            <td><%= job.customer_name %></td>
            <td><%= job.address %></td>
            <td><span class="badge badge-<%= job.status %>"><%= job.status.humanize %></span></td>
            <td><%= job.user.name %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No jobs in system.</p>
  <% end %>
<% end %>

<% if current_user.plumber? %>
  <h2>My Jobs</h2>
  <% if @my_jobs.present? %>
    <table>
      <thead>
        <tr>
          <th>Customer</th>
          <th>Address</th>
          <th>Scheduled</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @my_jobs.each do |job| %>
          <tr>
            <td><%= job.customer_name %></td>
            <td><%= job.address %></td>
            <td><%= job.scheduled_date&.strftime("%Y-%m-%d") %> at <%= job.scheduled_time&.strftime("%H:%M") %></td>
            <td><span class="badge badge-<%= job.status %>"><%= job.status.humanize %></span></td>
            <td>
              <%= link_to "Update Status", edit_job_path(job) %>
              <%= link_to "Send WhatsApp", whatsapp_job_path(job), class: "btn", data: { confirm: "Open WhatsApp to send address to customer?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No jobs assigned to you.</p>
  <% end %>
<% end %>