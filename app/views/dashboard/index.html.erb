<div class="hero">
  <div class="hero-logo">
    <%= image_tag "INDUSTRO-PLUMBERS.png", alt: "Industro Plumbers" %>
    <div>
      <div class="brand-name">Industro Plumbers</div>
      <div class="brand-tag">Dashboard</div>
    </div>
  </div>
</div>

<% if current_user.super_admin? %>
  <% dl_counts = {
       pending:    @pending_jobs.count,
       scheduled:  @scheduled_jobs.count,
       in_progress: @in_progress_jobs.count,
       completed:  @completed_jobs.count
     } %>
  <div class="kpi-strip">
    <div class="kpi kpi-pending">
      <div class="label">Pending</div>
      <div class="value"><%= dl_counts[:pending] %></div>
      <div class="sub">Awaiting schedule</div>
    </div>
    <div class="kpi kpi-scheduled">
      <div class="label">Scheduled</div>
      <div class="value"><%= dl_counts[:scheduled] %></div>
      <div class="sub">Booked in</div>
    </div>
    <div class="kpi kpi-progress">
      <div class="label">In Progress</div>
      <div class="value"><%= dl_counts[:in_progress] %></div>
      <div class="sub">On site</div>
    </div>
    <div class="kpi kpi-completed">
      <div class="label">Completed</div>
      <div class="value"><%= dl_counts[:completed] %></div>
      <div class="sub">All done</div>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h2>Job Pipeline</h2>
      <div style="display: flex; gap: 0.75rem; align-items: center;">
        <%= form_with url: dashboard_path, method: :get, local: true, style: "display: flex; gap: 0.5rem;" do |f| %>
          <%= f.text_field :q, value: @search_query, placeholder: "Search by job #, customer, address...", style: "padding: 0.5rem 0.75rem; border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 0.875rem; width: 280px;" %>
          <%= f.submit "Search", class: "btn btn-sm" %>
          <% if @search_query.present? %>
            <%= link_to "Clear", dashboard_path, class: "btn btn-sm btn-secondary" %>
            <% end %>
        <% end %>
        <%= link_to "New Job", new_job_path, class: "btn" %>
      </div>
    </div>
    <div class="card-body no-padding">
      <% if @my_jobs.present? %>
        <div class="modern-table" style="border: none; box-shadow: none; border-radius: 0;">
        <table>
          <thead>
            <tr>
              <th>Job #</th>
              <th>Time</th>
              <th>Customer</th>
              <th>Problem</th>
              <th>Address</th>
              <th>Contact Number</th>
              <th>Status</th>
              <th>Scheduled</th>
              <th>Assigned To</th>
              <th>Invoice</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @my_jobs.each do |job| %>
              <tr>
                <td><span style="font-family: monospace; font-size: 0.8rem; color: var(--text-muted);"><%= job.job_number || "N/A" %></span></td>
                <td><%= job.scheduled_time&.strftime("%I:%M %p")&.strip || "—" %></td>
                <td><%= job.customer_name %></td>
                <td><%= job.description.to_s.truncate(60) %></td>
                <td><%= job.address.to_s.truncate(40) %></td>
                <td>
                  <div style="font-size: 0.875rem;">
                    <div style="color: var(--text-muted);"><%= job.contact_number || job.client&.phone_number || "—" %></div>
                    <% if job.client&.email.present? && job.contact_number.blank? %>
                      <div style="color: var(--text-muted);"><%= job.client.email %></div>
                    <% end %>
                  </div>
                </td>
                <td><%= render "status_dropdown", job: job %></td>
                <td><%= job.scheduled_date&.strftime("%b %d") || "—" %></td>
                <td><%= job.assigned_to&.name || "Unassigned" %></td>
                <td><%= job.invoice_number || "—" %></td>
                <td>
                  <%= link_to "View", job, class: "btn btn-sm" %>
                  <%= link_to "Edit", edit_job_path(job), class: "btn btn-sm btn-secondary" %>
                  <%= button_to "Delete", job, method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-sm btn-danger", style: "display: inline;" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        </div>
      <% else %>
        <div class="empty-state">No jobs yet. Create your first job to get started.</div>
      <% end %>
    </div>
  </div>

  <%= render "outstanding_jobs" %>
  <%= render "schedule_view" %>
<% end %>

<% if current_user.accountant? %>
  <div class="kpi-strip">
    <div class="kpi kpi-pending">
      <div class="label">Pending</div>
      <div class="value"><%= @pending_jobs.count %></div>
      <div class="sub">Need invoices</div>
    </div>
    <div class="kpi kpi-scheduled">
      <div class="label">Scheduled</div>
      <div class="value"><%= @scheduled_jobs.count %></div>
      <div class="sub">Upcoming</div>
    </div>
    <div class="kpi kpi-progress">
      <div class="label">In Progress</div>
      <div class="value"><%= @in_progress_jobs.count %></div>
      <div class="sub">Active</div>
    </div>
    <div class="kpi kpi-completed">
      <div class="label">Completed</div>
      <div class="value"><%= @completed_jobs.count %></div>
      <div class="sub">Ready to invoice</div>
    </div>
  </div>

  <%= render "outstanding_jobs" %>

  <%= form_with url: dashboard_path, method: :get, local: true, style: "margin-bottom: 1.5rem; display: flex; gap: 0.75rem; align-items: center;" do |f| %>
    <%= f.text_field :q, value: @search_query, placeholder: "Search by Job Number, Address, or Invoice Number...", style: "padding: 0.625rem 0.875rem; border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 0.875rem; flex: 1; max-width: 400px;" %>
    <%= f.submit "Search", class: "btn" %>
    <% if @search_query.present? %>
      <%= link_to "Clear", dashboard_path, class: "btn btn-secondary" %>
    <% end %>
  <% end %>

  <% if @pending_jobs.present? %>
    <div class="section-title">Pending Jobs</div>
    <div class="card">
      <div class="card-body no-padding">
        <div class="modern-table" style="border: none; box-shadow: none; border-radius: 0;">
        <table>
          <thead>
            <tr>
              <th>Job #</th>
              <th>Customer</th>
              <th>Address</th>
              <th>Status</th>
              <th>Priority</th>
              <th>Created By</th>
              <th>Invoice #</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% @pending_jobs.each do |job| %>
              <tr>
                <td><%= job.job_number || "N/A" %></td>
                <td><%= job.customer_name %></td>
                <td><%= job.address.truncate(40) %></td>
                <td><%= render "status_dropdown", job: job %></td>
                <td><%= job.priority.humanize %></td>
                <td><%= job.user.name %></td>
                <td><%= job.invoice_number || "—" %></td>
                <td>
                  <%= button_to "Close Job", close_job_path(job), method: :patch, data: { confirm: "Close this job and mark it as completed with invoice?" }, class: "btn btn-sm btn-success", style: "display: inline; padding: 0.25rem 0.5rem; font-size: 0.875rem;" %>
                  <%= link_to "Assign Invoice", edit_job_path(job), class: "btn btn-sm" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        </div>
      </div>
    </div>
  <% end %>

  <% if @scheduled_jobs.present? %>
    <div class="section-title">Scheduled Jobs</div>
    <div class="card">
      <div class="card-body no-padding">
        <div class="modern-table" style="border: none; box-shadow: none; border-radius: 0;">
        <table>
          <thead>
            <tr>
              <th>Job #</th>
              <th>Customer</th>
              <th>Address</th>
              <th>Status</th>
              <th>Scheduled</th>
              <th>Assigned To</th>
              <th>Invoice #</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% @scheduled_jobs.each do |job| %>
              <tr>
                <td><%= job.job_number || "N/A" %></td>
                <td><%= job.customer_name %></td>
                <td><%= job.address.truncate(40) %></td>
                <td><%= render "status_dropdown", job: job %></td>
                <td><%= job.scheduled_date&.strftime("%b %d, %Y") %> at <%= (job.scheduled_time&.strftime("%I:%M %p")&.strip || "TBD") %></td>
                <td><%= job.assigned_to&.name || "Unassigned" %></td>
                <td><%= job.invoice_number || "—" %></td>
                <td>
                  <%= button_to "Close Job", close_job_path(job), method: :patch, data: { confirm: "Close this job and mark it as completed with invoice?" }, class: "btn btn-sm btn-success", style: "display: inline; padding: 0.25rem 0.5rem; font-size: 0.875rem;" %>
                  <%= link_to "Assign Invoice", edit_job_path(job), class: "btn btn-sm" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        </div>
      </div>
    </div>
  <% end %>

  <% if @in_progress_jobs.present? %>
    <div class="section-title">In Progress Jobs</div>
    <div class="card">
      <div class="card-body no-padding">
        <div class="modern-table" style="border: none; box-shadow: none; border-radius: 0;">
        <table>
          <thead>
            <tr>
              <th>Job #</th>
              <th>Customer</th>
              <th>Address</th>
              <th>Status</th>
              <th>Assigned To</th>
              <th>Invoice #</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% @in_progress_jobs.each do |job| %>
              <tr>
                <td><%= job.job_number || "N/A" %></td>
                <td><%= job.customer_name %></td>
                <td><%= job.address.truncate(40) %></td>
                <td><%= render "status_dropdown", job: job %></td>
                <td><%= job.assigned_to&.name || "Unassigned" %></td>
                <td><%= job.invoice_number || "—" %></td>
                <td>
                  <%= button_to "Close Job", close_job_path(job), method: :patch, data: { confirm: "Close this job and mark it as completed with invoice?" }, class: "btn btn-sm btn-success", style: "display: inline; padding: 0.25rem 0.5rem; font-size: 0.875rem;" %>
                  <%= link_to "Assign Invoice", edit_job_path(job), class: "btn btn-sm" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        </div>
      </div>
    </div>
  <% end %>

  <% if @completed_jobs.present? %>
    <div class="section-title">Completed Jobs</div>
    <div class="card">
      <div class="card-body no-padding">
        <div class="modern-table" style="border: none; box-shadow: none; border-radius: 0;">
        <table>
          <thead>
            <tr>
              <th>Job #</th>
              <th>Customer</th>
              <th>Address</th>
              <th>Completed</th>
              <th>Invoice #</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% @completed_jobs.each do |job| %>
              <tr>
                <td><%= job.job_number || "N/A" %></td>
                <td><%= job.customer_name %></td>
                <td><%= job.address.truncate(40) %></td>
                <td><%= job.completed_at&.strftime("%b %d, %Y %I:%M %p") || "N/A" %></td>
                <td><%= job.invoice_number || "—" %></td>
                <td><%= link_to "Assign Invoice", edit_job_path(job), class: "btn btn-sm" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
        </div>
      </div>
    </div>
  <% end %>
<% end %>

<% if current_user.scheduler? %>
  <div class="stats-grid">
    <div class="stat-card">
      <span class="stat-label">Pending</span>
      <span class="stat-value"><%= @pending_jobs.count %></span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Scheduled</span>
      <span class="stat-value"><%= @scheduled_count %></span>
    </div>
    <div class="stat-card">
      <span class="stat-label">In Progress</span>
      <span class="stat-value"><%= @in_progress_jobs.count %></span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Completed</span>
      <span class="stat-value"><%= @completed_jobs.count %></span>
    </div>
  </div>

  <%= render "outstanding_jobs" %>

  <div class="card">
    <div class="card-header">
      <h2>Pending Jobs</h2>
      <%= link_to "Calendar View", calendar_path, class: "btn btn-sm" %>
    </div>
    <div class="card-body no-padding">
      <% if @pending_jobs.present? %>
        <div class="modern-table" style="border: none; box-shadow: none; border-radius: 0;">
        <table>
          <thead>
            <tr>
              <th>Customer</th>
              <th>Address</th>
              <th>Description</th>
              <th>Status</th>
              <th>Priority</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @pending_jobs.each do |job| %>
              <tr>
                <td><strong><%= job.customer_name %></strong></td>
                <td><%= job.address.truncate(40) %></td>
                <td><%= job.description.truncate(60) %></td>
                <td><%= render "status_dropdown", job: job %></td>
                <td><%= job.priority.humanize %></td>
                <td>
                  <%= form_with url: schedule_job_path(job), method: :patch, local: true do |f| %>
                    <%= f.hidden_field :status, value: "scheduled" %>
                    <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                      <%= f.date_field :scheduled_date, value: @scheduler_date, required: true, style: "padding: 0.4rem; border: 1px solid var(--border); border-radius: 6px; font-size: 0.875rem;" %>
                      <%= f.time_field :scheduled_time, value: "08:00", required: true, style: "padding: 0.4rem; border: 1px solid var(--border); border-radius: 6px; font-size: 0.875rem;" %>
                      <%= f.select :assigned_to_id, options_from_collection_for_select(User.plumber, :id, :name, job.assigned_to_id), { include_blank: "Plumber" }, { style: "padding: 0.4rem; border: 1px solid var(--border); border-radius: 6px; font-size: 0.875rem;" } %>
                      <%= f.submit "Schedule", class: "btn btn-sm btn-success" %>
                    </div>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        </div>
      <% else %>
        <div class="empty-state">All jobs are scheduled!</div>
      <% end %>
    </div>
  </div>

  <%= render "schedule_view" %>

  <% if @scheduler_view == "day" && @scheduled_jobs.present? %>
    <%= link_to "Send All #{@scheduler_date.strftime('%A')}'s Jobs via WhatsApp", bulk_whatsapp_jobs_path(scheduled_date: @scheduler_date), class: "btn btn-success", style: "margin-top: 1rem;" %>
  <% end %>
<% end %>

<% if current_user.reporter? %>
  <%= render "outstanding_jobs" %>

  <div class="page-header">
    <h2>Daily Report - <%= Date.today.strftime("%B %d, %Y") %></h2>
    <p>Track today's job activity and purchase orders.</p>
  </div>

  <h3 class="section-title">Today's Jobs</h3>
  <div class="card">
    <div class="card-body no-padding">
      <% if @today_jobs.present? %>
        <div class="modern-table" style="border: none; box-shadow: none; border-radius: 0;">
        <table>
          <thead>
            <tr>
              <th>Job #</th>
              <th>Time</th>
              <th>Customer</th>
              <th>Address</th>
              <th>Description</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% @today_jobs.each do |job| %>
              <tr>
                <td><%= link_to (job.job_number || "N/A"), job_path(job), style: "color: var(--primary); text-decoration: none; font-weight: 600;", title: "View job and purchase orders" %></td>
                <td><%= job.created_at.strftime("%I:%M %p")&.strip %></td>
                <td><%= job.customer_name %></td>
                <td><%= job.address.truncate(35) %></td>
                <td><%= job.description.truncate(50) %></td>
                <td><%= render "status_dropdown", job: job %></td>
                <td><%= link_to "Add PO", new_job_purchase_order_path(job), class: "btn btn-sm" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
        </div>
        <div style="padding: 1rem 1.5rem; background: var(--bg); font-size: 0.875rem; color: var(--text-muted);">
          Total jobs today: <strong><%= @today_jobs.count %></strong>
        </div>
      <% else %>
        <div class="empty-state">No jobs logged today.</div>
      <% end %>
    </div>
  </div>

  <h3 class="section-title">All Jobs</h3>
  <div class="card">
    <div class="card-body no-padding">
      <% if @all_jobs.present? %>
        <div class="modern-table" style="border: none; box-shadow: none; border-radius: 0;">
        <table>
          <thead>
            <tr>
              <th>Job #</th>
              <th>Date</th>
              <th>Customer</th>
              <th>Address</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% @all_jobs.each do |job| %>
              <tr>
                <td><%= link_to (job.job_number || "N/A"), job_path(job), style: "color: var(--primary); text-decoration: none; font-weight: 600;", title: "View job and purchase orders" %></td>
                <td><%= job.created_at.strftime("%Y-%m-%d") %></td>
                <td><%= job.customer_name %></td>
                <td><%= job.address.truncate(40) %></td>
                <td><%= render "status_dropdown", job: job %></td>
                <td><%= link_to "Add PO", new_job_purchase_order_path(job), class: "btn btn-sm" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
        </div>
      <% else %>
        <div class="empty-state">No jobs in system.</div>
      <% end %>
    </div>
  </div>
<% end %>

<% if current_user.plumber? %>
  <div class="page-header">
    <h2>My Jobs</h2>
    <p>Jobs assigned to you and their current status.</p>
  </div>

  <div class="stats-grid">
    <div class="stat-card stat-pending">
      <span class="stat-value"><%= @pending_jobs.count %></span>
      <span class="stat-label">Pending</span>
    </div>
    <div class="stat-card stat-in-progress">
      <span class="stat-value"><%= @in_progress_jobs.count %></span>
      <span class="stat-label">In Progress</span>
    </div>
    <div class="stat-card stat-completed">
      <span class="stat-value"><%= @completed_jobs.count %></span>
      <span class="stat-label">Completed</span>
    </div>
  </div>

  <% if @my_jobs.present? %>
    <div class="card">
      <div class="card-body no-padding">
        <div class="modern-table" style="border: none; box-shadow: none; border-radius: 0;">
        <table>
          <thead>
            <tr>
              <th>Customer</th>
              <th>Address</th>
              <th>Scheduled</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @my_jobs.each do |job| %>
              <tr>
                <td><%= job.customer_name %></td>
                <td><%= job.address.truncate(40) %></td>
                <td><%= job.scheduled_date&.strftime("%b %d, %Y") %> at <%= (job.scheduled_time&.strftime("%I:%M %p")&.strip || "TBD") %></td>
                <td><%= render "status_dropdown", job: job %></td>
                <td>
                  <%= link_to "Update Status", edit_job_path(job), class: "btn btn-sm" %>
                  <%= link_to "WhatsApp", whatsapp_job_path(job), class: "btn btn-sm btn-success", data: { confirm: "Open WhatsApp to send address to customer?" } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        </div>
      </div>
    </div>
  <% else %>
    <div class="card">
      <div class="card-body">
        <div class="empty-state">No jobs assigned to you. Check back later or contact the scheduler.</div>
      </div>
    </div>
  <% end %>
<% end %>
