<% content_for :full_page do %>
  <div class="login-page">
    <div class="login-card">
      <div class="login-header">
        <h1>Industro Plumbers</h1>
        <p>Sign in to your account</p>
      </div>
      <% if notice %>
        <div class="notice"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="alert"><%= alert %></div>
      <% end %>
      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="field">
          <%= f.label :email, "Email" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@company.com", value: @remembered_email %>
        </div>
        <div class="field" style="position: relative;">
          <%= f.label :password, "Password" %>
          <div style="position: relative;">
            <%= f.password_field :password, autocomplete: "current-password", placeholder: "Password", style: "padding-right: 2.5rem;", id: "login_password" %>
            <button type="button" onclick="togglePasswordVisibility()" style="position: absolute; right: 0.5rem; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; padding: 0.25rem; display: flex; align-items: center; justify-content: center;" aria-label="Toggle password visibility">
              <svg id="eye-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #6b7280;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
            </button>
          </div>
        </div>
        <div class="field remember-me">
          <%= check_box_tag :stay_logged_in, "1", false, style: "width: 18px; height: 18px; margin-right: 0.5rem; accent-color: #B2D33E; cursor: pointer;" %>
          <%= label_tag :stay_logged_in, "Stay Logged In", style: "font-weight: 600; color: #fff; cursor: pointer;" %>
        </div>
        <div class="actions">
          <%= f.submit "Sign In", class: "btn-login" %>
        </div>
      <% end %>
      <% if @remembered_email.present? %>
        <div style="text-align: center; margin-top: 1rem;">
          <%= link_to "Clear remembered email", stop_stay_logged_in_path, style: "color: rgba(255,255,255,0.7); font-size: 0.8rem; text-decoration: none;" %>
        </div>
      <% end %>
      <div class="devise-links">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
  <script>
    function togglePasswordVisibility() {
      var input = document.getElementById('login_password');
      var icon = document.getElementById('eye-icon');
      if (input.type === 'password') {
        input.type = 'text';
        icon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
      } else {
        input.type = 'password';
        icon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
      }
    }
  </script>
<% end %>

<%= render template: "layouts/application" %>