<% content_for :full_page do %>
  <div class="login-page">
    <div class="login-watermark">
      <%= image_tag "IndustroTap.jpg", alt: "" %>
    </div>
    <div class="login-card">
      <div class="login-header">
        <h1>Industro Plumbers</h1>
        <p>Sign in to your account</p>
      </div>
      <% if notice %>
        <div class="notice"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="alert"><%= alert %></div>
      <% end %>
      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="field">
          <%= f.label :email, "Email" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@company.com", value: @remembered_email %>
        </div>
        <div class="field">
          <%= f.label :password, "Password" %>
          <%= f.password_field :password, autocomplete: "current-password", placeholder: "Password" %>
        </div>
        <div class="field remember-me">
          <%= check_box_tag :stay_logged_in, "1", false, style: "width: 18px; height: 18px; margin-right: 0.5rem; accent-color: #B2D33E; cursor: pointer;" %>
          <%= label_tag :stay_logged_in, "Stay Logged In", style: "font-weight: 600; color: #fff; cursor: pointer;" %>
        </div>
        <div class="actions">
          <%= f.submit "Sign In", class: "btn-login" %>
        </div>
      <% end %>
      <% if @remembered_email.present? %>
        <div style="text-align: center; margin-top: 1rem;">
          <%= link_to "Clear remembered email", stop_stay_logged_in_path, style: "color: rgba(255,255,255,0.7); font-size: 0.8rem; text-decoration: none;" %>
        </div>
      <% end %>
      <div class="devise-links">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
<% end %>

<%= render template: "layouts/application" %>