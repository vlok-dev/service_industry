<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Industro Plumbers" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Industro Plumbers">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/IndustroPlumbers.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <style>
      :root {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --bg: #f8fafc;
        --surface: #ffffff;
        --text: #1e293b;
        --text-muted: #64748b;
        --border: #e2e8f0;
        --shadow: 0 1px 3px rgba(0,0,0,0.05), 0 1px 2px rgba(0,0,0,0.03);
        --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03);
        --radius: 12px;
        --radius-sm: 8px;
      }

      * { box-sizing: border-box; }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      /* Login Page */
      .login-page {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 2rem;
        background: #B2D33E;
      }

      .login-card {
        background: white;
        padding: 3rem;
        border-radius: var(--radius);
        box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04);
        width: 100%;
        max-width: 420px;
      }

      .login-header {
        text-align: center;
        margin-bottom: 2.5rem;
      }

      .login-header h1 {
        margin: 0 0 0.5rem 0;
        font-size: 1.875rem;
        font-weight: 700;
        color: #1e3a8a;
        letter-spacing: -0.025em;
      }

      .login-header p {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.95rem;
      }

      /* Navigation */
      nav {
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        padding: 0.875rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: sticky;
        top: 0;
        z-index: 100;
        backdrop-filter: blur(8px);
        background: rgba(255,255,255,0.9);
      }

      nav .brand {
        font-weight: 700;
        font-size: 1.125rem;
        color: var(--primary);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      nav .nav-links {
        display: flex;
        align-items: center;
        gap: 1.5rem;
      }

      nav a {
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: color 0.2s;
      }

      nav a:hover {
        color: var(--text);
      }

      .user-info {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: var(--text-muted);
        font-size: 0.875rem;
      }

      .user-info .name {
        color: var(--text);
        font-weight: 600;
      }

      .user-info .role {
        background: var(--bg);
        padding: 0.25rem 0.625rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--primary);
      }

      /* Container */
      .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem;
      }

      /* Cards */
      .card {
        background: var(--surface);
        border-radius: var(--radius);
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
        overflow: hidden;
      }

      .card-header {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .card-header h2 {
        margin: 0;
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--text);
      }

      .card-body {
        padding: 1.5rem;
      }

      .card-body.no-padding {
        padding: 0;
      }

      /* Page Headers */
      .page-header {
        margin-bottom: 2rem;
      }

      .page-header h1 {
        margin: 0 0 0.5rem 0;
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--text);
        letter-spacing: -0.025em;
      }

      .page-header p {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.95rem;
      }

      /* Buttons */
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.625rem 1rem;
        background: var(--primary);
        color: white;
        text-decoration: none;
        border-radius: var(--radius-sm);
        font-size: 0.875rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: all 0.2s;
        white-space: nowrap;
      }

      .btn:hover {
        background: var(--primary-dark);
        transform: translateY(-1px);
        box-shadow: var(--shadow-md);
      }

      .btn-success {
        background: #059669;
      }

      .btn-success:hover {
        background: #047857;
      }

      .btn-danger {
        background: #dc2626;
      }

      .btn-danger:hover {
        background: #b91c1c;
      }

      .btn-secondary {
        background: var(--bg);
        color: var(--text);
        border: 1px solid var(--border);
      }

      .btn-secondary:hover {
        background: var(--border);
      }

      .btn-sm {
        padding: 0.375rem 0.75rem;
        font-size: 0.8rem;
      }

      /* Tables */
      table {
        width: 100%;
        border-collapse: collapse;
      }

      th {
        text-align: left;
        padding: 0.75rem 1rem;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
        background: var(--bg);
        border-bottom: 1px solid var(--border);
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      }

      td {
        padding: 1rem;
        border-bottom: 1px solid var(--border);
        font-size: 0.875rem;
        color: var(--text);
      }

      tr:last-child td {
        border-bottom: none;
      }

      tr:hover td {
        background: var(--bg);
      }

      /* Badges */
      .badge {
        display: inline-flex;
        align-items: center;
        padding: 0.25rem 0.625rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
        line-height: 1;
      }

      .badge-pending { background: #fef3c7; color: #92400e; }
      .badge-scheduled { background: #dbeafe; color: #1e40af; }
      .badge-in-progress { background: #fce7f3; color: #9d174d; }
      .badge-completed { background: #d1fae5; color: #065f46; }
      .badge-cancelled { background: #fee2e2; color: #991b1b; }

      /* Forms */
      .field {
        margin-bottom: 1.25rem;
      }

      .field label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 500;
        color: var(--text);
        font-size: 0.875rem;
      }

      .field input[type="text"],
      .field input[type="email"],
      .field input[type="password"],
      .field input[type="time"],
      .field input[type="date"],
      .field textarea,
      .field select {
        width: 100%;
        padding: 0.625rem 0.875rem;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        font-size: 0.9rem;
        background: var(--surface);
        transition: border-color 0.2s, box-shadow 0.2s;
      }

      .field input:focus,
      .field textarea:focus,
      .field select:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
      }

      .field input:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
      }

      .remember-me {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .remember-me input[type="checkbox"] {
        width: auto;
      }

      .remember-me label {
        margin: 0;
        font-weight: normal;
      }

      .btn-login {
        width: 100%;
        padding: 0.75rem;
        background: #B2D33E;
        color: white;
        border: none;
        border-radius: var(--radius-sm);
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
      }

      .btn-login:hover {
        background: #1B2C65;
      }

      /* Alerts */
      .notice {
        background: #d1fae5;
        color: #065f46;
        padding: 0.875rem 1.25rem;
        border-radius: var(--radius-sm);
        margin-bottom: 1rem;
        font-size: 0.875rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .alert {
        background: #fee2e2;
        color: #991b1b;
        padding: 0.875rem 1.25rem;
        border-radius: var(--radius-sm);
        margin-bottom: 1rem;
        font-size: 0.875rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      /* Scheduler Controls */
      .scheduler-controls {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: center;
        justify-content: space-between;
        margin: 1.5rem 0;
        padding: 1.25rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }

      .view-tabs {
        display: flex;
        gap: 0.375rem;
        background: var(--bg);
        padding: 0.25rem;
        border-radius: var(--radius-sm);
      }

      .view-tab {
        padding: 0.5rem 1rem;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--text-muted);
        transition: all 0.2s;
      }

      .view-tab.active {
        background: var(--surface);
        color: var(--primary);
        box-shadow: var(--shadow);
        font-weight: 600;
      }

      .view-tab:hover {
        color: var(--text);
      }

      .view-tab.active:hover {
        color: var(--primary);
      }

      .date-navigation {
        display: flex;
        gap: 0.5rem;
        align-items: center;
      }

      .date-display h2 {
        margin: 0;
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--text);
      }

      .date-picker {
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        font-size: 0.875rem;
        font-family: inherit;
      }

      /* Stats Grid */
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
      }

      .stat-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.25rem;
        box-shadow: var(--shadow);
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }

      .stat-label {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
      }

      .stat-value {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--text);
        line-height: 1;
      }

      /* Section headers */
      .section-title {
        font-size: 1.125rem;
        font-weight: 600;
        margin: 2rem 0 1rem 0;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid var(--border);
        color: var(--text);
      }

      /* Empty states */
      .empty-state {
        text-align: center;
        padding: 3rem 2rem;
        color: var(--text-muted);
      }

      .empty-state svg {
        width: 48px;
        height: 48px;
        margin-bottom: 1rem;
        opacity: 0.4;
      }
    </style>
  </head>

  <body>
    <% if content_for?(:full_page) %>
      <%= yield :full_page %>
    <% else %>
      <nav>
        <%= link_to root_path, class: "brand" do %>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
          Industro Plumbers
        <% end %>
        <% if user_signed_in? %>
          <div class="nav-links">
            <div class="user-info">
              <span class="name"><%= current_user.name %></span>
              <span class="role"><%= current_user.role&.humanize || "User" %></span>
            </div>
            <%= link_to "Jobs", jobs_path %>
            <%= link_to "Dashboard", dashboard_path %>
            <% if current_user.scheduler? %>
              <%= link_to "Calendar", calendar_path %>
            <% end %>
            <% if current_user.admin? || current_user.super_admin? %>
              <%= link_to "Admin", admin_root_path %>
            <% end %>
            <%= button_to "Logout", "/users/sign_out", method: :delete, form: { data: { turbo: false } }, style: "background: none; border: none; color: var(--text-muted); cursor: pointer; text-decoration: underline; display: inline; padding: 0; font-size: 0.875rem; font-family: inherit;" %>
          </div>
        <% else %>
          <div class="nav-links">
            <%= link_to "Login", new_user_session_path %>
          </div>
        <% end %>
      </nav>

      <div class="container">
        <% if notice %>
          <div class="notice"><%= notice %></div>
        <% end %>
        <% if alert %>
          <div class="alert"><%= alert %></div>
        <% end %>

        <%= yield %>
      </div>
    <% end %>
  </body>
</html>