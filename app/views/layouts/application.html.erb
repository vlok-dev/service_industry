<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Industro Plumbers" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Industro Plumbers">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/IndustroPlumbers.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <style>
      body { font-family: system-ui, sans-serif; margin: 0; padding: 0; }
      nav { background: #1e3a8a; padding: 1rem; }
      nav a { color: white; margin-right: 1rem; text-decoration: none; }
      nav a:hover { text-decoration: underline; }
      .container { padding: 2rem; max-width: 1200px; margin: 0 auto; }
      .notice { background: #d1fae5; padding: 1rem; border-radius: 4px; margin-bottom: 1rem; }
      .alert { background: #fee2e2; padding: 1rem; border-radius: 4px; margin-bottom: 1rem; }
      table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
      th, td { padding: 0.75rem; text-align: left; border-bottom: 1px solid #e5e7eb; }
      th { background: #f3f4f6; }
      .btn { display: inline-block; padding: 0.5rem 1rem; background: #2563eb; color: white; text-decoration: none; border-radius: 4px; margin-right: 0.5rem; }
      .btn:hover { background: #1d4ed8; }
      .btn-danger { background: #dc2626; }
      .btn-danger:hover { background: #b91c1c; }
      .btn-success { background: #059669; }
      .btn-success:hover { background: #047857; }
      .badge { padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.875rem; }
      .badge-pending { background: #fef3c7; color: #92400e; }
      .badge-scheduled { background: #dbeafe; color: #1e40af; }
      .badge-in-progress { background: #fce7f3; color: #9d174d; }
      .badge-completed { background: #d1fae5; color: #065f46; }
      .badge-cancelled { background: #fee2e2; color: #991b1b; }
    </style>
  </head>

  <body>
    <nav>
      <%= link_to "Industro Plumbers", root_path %>
      <% if user_signed_in? %>
        <span style="color: #93c5fd; margin-left: 1rem;"><%= current_user.name %> (<%= current_user.role&.humanize || "User" %>)</span>
        <%= link_to "Jobs", jobs_path %>
        <%= link_to "Dashboard", root_path %>
        <% if current_user.admin? || current_user.super_admin? %>
          <%= link_to "Admin", admin_root_path %>
        <% end %>
        <%= button_to "Logout", destroy_user_session_path, method: :delete, style: "background: none; border: none; color: white; cursor: pointer; text-decoration: underline; display: inline; padding: 0;" %>
      <% else %>
        <%= link_to "Login", new_user_session_path %>
      <% end %>
    </nav>

    <div class="container">
      <% if notice %>
        <div class="notice"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="alert"><%= alert %></div>
      <% end %>

      <%= yield %>
    </div>
  </body>
</html>