<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Industro Plumbers" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Industro Plumbers">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/IndustroPlumbers.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <style>
      :root {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --bg: #f8fafc;
        --surface: #ffffff;
        --text: #0f172a;
        --text-muted: #64748b;
        --border: #e2e8f0;
        --border-light: #f1f5f9;
        --primary-light: #eff6ff;
        --shadow: 0 1px 3px rgba(0,0,0,0.05), 0 1px 2px rgba(0,0,0,0.03);
        --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03);
        --radius: 12px;
        --radius-sm: 8px;
      }

      * { box-sizing: border-box; }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      /* Login Page */
      .login-page {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 2rem;
        background: linear-gradient(135deg, #B2D33E 0%, #1B2C65 100%);
      }

      .login-card {
        background: white;
        padding: 3rem;
        border-radius: var(--radius);
        box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04);
        width: 100%;
        max-width: 420px;
      }

      .login-header {
        text-align: center;
        margin-bottom: 2.5rem;
      }

      .login-header h1 {
        margin: 0 0 0.5rem 0;
        font-size: 1.875rem;
        font-weight: 700;
        color: #1e3a8a;
        letter-spacing: -0.025em;
      }

      .login-header p {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.95rem;
      }

      /* Navigation */
      nav {
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        padding: 0.875rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: sticky;
        top: 0;
        z-index: 100;
        box-shadow: var(--shadow);
      }

      nav .brand {
        font-weight: 700;
        font-size: 1.125rem;
        color: var(--primary);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      nav .nav-links {
        display: flex;
        align-items: center;
        gap: 1.5rem;
      }

      nav a {
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: color 0.2s;
      }

      nav a:hover {
        color: var(--text);
      }

      .user-info {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: var(--text-muted);
        font-size: 0.875rem;
      }

      .user-info .name {
        color: var(--text);
        font-weight: 600;
      }

      .user-info .role {
        background: var(--bg);
        padding: 0.25rem 0.625rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--primary);
      }

      /* Container */
      .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem;
      }

      /* Cards */
      .card {
        background: var(--surface);
        border-radius: var(--radius);
        border: 1px solid var(--border-light);
        box-shadow: var(--shadow);
        overflow: hidden;
        margin-bottom: 1.5rem;
      }

      .card-header {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .card-header h2 {
        margin: 0;
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--text);
      }

      .card-body {
        padding: 1.5rem;
      }

      .card-body.no-padding {
        padding: 0;
      }

      /* Page Headers */
      .page-header {
        margin-bottom: 2rem;
      }

      .page-header h1 {
        margin: 0 0 0.5rem 0;
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--text);
        letter-spacing: -0.025em;
      }

      .page-header p {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.95rem;
      }

      /* Buttons */
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.625rem 1rem;
        background: var(--primary);
        color: white;
        text-decoration: none;
        border-radius: var(--radius-sm);
        font-size: 0.875rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: all 0.2s;
        white-space: nowrap;
      }

      .btn:hover {
        background: var(--primary-dark);
        transform: translateY(-1px);
        box-shadow: var(--shadow-md);
      }

      .btn-success {
        background: #059669;
      }

      .btn-success:hover {
        background: #047857;
      }

      .btn-danger {
        background: #dc2626;
      }

      .btn-danger:hover {
        background: #b91c1c;
      }

      .btn-secondary {
        background: var(--bg);
        color: var(--text);
        border: 1px solid var(--border);
      }

      .btn-secondary:hover {
        background: var(--border);
      }

      .btn-sm {
        padding: 0.375rem 0.75rem;
        font-size: 0.8rem;
      }

      /* Tables */
      table {
        width: 100%;
        border-collapse: collapse;
      }

      th {
        text-align: left;
        padding: 0.75rem 1rem;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
        background: var(--bg);
        border-bottom: 1px solid var(--border);
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      }

      td {
        padding: 1rem;
        border-bottom: 1px solid var(--border);
        font-size: 0.875rem;
        color: var(--text);
      }

      tr:last-child td {
        border-bottom: none;
      }

      tr:hover td {
        background: var(--primary-light);
      }

      /* Badges */
      .badge {
        display: inline-flex;
        align-items: center;
        padding: 0.25rem 0.625rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
        line-height: 1;
      }

      .badge-pending { background: #fef3c7; color: #92400e; }
      .badge-scheduled { background: #dbeafe; color: #1e40af; }
      .badge-in-progress { background: #fce7f3; color: #9d174d; }
      .badge-completed { background: #d1fae5; color: #065f46; }
      .badge-cancelled { background: #fee2e2; color: #991b1b; }

      /* Forms */
      .field {
        margin-bottom: 1.25rem;
      }

      .field label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 500;
        color: var(--text);
        font-size: 0.875rem;
      }

      .field input[type="text"],
      .field input[type="email"],
      .field input[type="password"],
      .field input[type="time"],
      .field input[type="date"],
      .field textarea,
      .field select {
        width: 100%;
        padding: 0.625rem 0.875rem;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        font-size: 0.9rem;
        background: var(--surface);
        transition: border-color 0.2s, box-shadow 0.2s;
      }

      .field input:focus,
      .field textarea:focus,
      .field select:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
      }

      .field input:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
      }

      .remember-me {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .remember-me input[type="checkbox"] {
        width: auto;
      }

      .remember-me label {
        margin: 0;
        font-weight: normal;
      }

      .btn-login {
        width: 100%;
        padding: 0.75rem;
        background: #B2D33E;
        color: white;
        border: none;
        border-radius: var(--radius-sm);
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
      }

      .btn-login:hover {
        background: #1B2C65;
      }

      /* Alerts */
      .notice {
        background: #d1fae5;
        color: #065f46;
        padding: 0.875rem 1.25rem;
        border-radius: var(--radius-sm);
        margin-bottom: 1rem;
        font-size: 0.875rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .alert {
        background: #fee2e2;
        color: #991b1b;
        padding: 0.875rem 1.25rem;
        border-radius: var(--radius-sm);
        margin-bottom: 1rem;
        font-size: 0.875rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      /* Scheduler Controls */
      .scheduler-controls {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: center;
        justify-content: space-between;
        margin: 1.5rem 0;
        padding: 1.25rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }

      .view-tabs {
        display: flex;
        gap: 0.375rem;
        background: var(--bg);
        padding: 0.25rem;
        border-radius: var(--radius-sm);
      }

      .view-tab {
        padding: 0.5rem 1rem;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--text-muted);
        transition: all 0.2s;
      }

      .view-tab.active {
        background: var(--surface);
        color: var(--primary);
        box-shadow: var(--shadow);
        font-weight: 600;
      }

      .view-tab:hover {
        color: var(--text);
      }

      .view-tab.active:hover {
        color: var(--primary);
      }

      .date-navigation {
        display: flex;
        gap: 0.5rem;
        align-items: center;
      }

      .date-display h2 {
        margin: 0;
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--text);
      }

      .date-picker {
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        font-size: 0.875rem;
        font-family: inherit;
      }

      /* Stats Grid */
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
      }

      .stat-card {
        background: var(--surface);
        border: 1px solid var(--border-light);
        border-radius: var(--radius);
        padding: 1.25rem 1.5rem;
        box-shadow: var(--shadow);
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        transition: transform 0.2s, box-shadow 0.2s;
        position: relative;
        overflow: hidden;
      }
      .stat-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        border-radius: var(--radius) 0 0 var(--radius);
      }
      .stat-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }

      .stat-card.stat-pending::before { background: #f59e0b; }
      .stat-card.stat-scheduled::before { background: #3b82f6; }
      .stat-card.stat-in-progress::before { background: #ec4899; }
      .stat-card.stat-completed::before { background: #10b981; }
      .stat-card.stat-default::before { background: var(--primary); }

      .stat-label {
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted);
        margin-top: 0.25rem;
      }

      .stat-value {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--text);
        line-height: 1;
      }

      /* Section headers */
      .section-title {
        font-size: 1.125rem;
        font-weight: 600;
        margin: 2rem 0 1rem 0;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid var(--border);
        color: var(--text);
      }

      /* Empty states */
      .empty-state {
        text-align: center;
        padding: 3rem 2rem;
        color: var(--text-muted);
      }

      .empty-state svg {
        width: 48px;
        height: 48px;
        margin-bottom: 1rem;
        opacity: 0.4;
      }

      /* ===================== Job & Dashboard visual upgrades ===================== */

      /* Hero header (used on job show + dashboard top) */
      .hero {
        position: relative;
        border-radius: var(--radius);
        padding: 1.75rem 2rem;
        margin-bottom: 1.5rem;
        color: white;
        background: linear-gradient(135deg, #1B2C65 0%, #2563eb 60%, #4f46e5 100%);
        box-shadow: 0 10px 25px -5px rgba(37, 99, 235, 0.35);
        overflow: hidden;
      }
      .hero::before {
        content: "";
        position: absolute;
        right: -40px;
        top: -40px;
        width: 220px;
        height: 220px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(178, 211, 62, 0.45) 0%, transparent 70%);
        pointer-events: none;
      }
      .hero::after {
        content: "";
        position: absolute;
        left: -60px;
        bottom: -60px;
        width: 200px;
        height: 200px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(255, 255, 255, 0.08) 0%, transparent 70%);
        pointer-events: none;
      }
      .hero h1 {
        margin: 0 0 0.25rem 0;
        font-size: 1.875rem;
        font-weight: 700;
        letter-spacing: -0.025em;
        position: relative;
        z-index: 1;
      }
      .hero .subtitle {
        margin: 0;
        opacity: 0.9;
        font-size: 0.95rem;
        position: relative;
        z-index: 1;
      }
      .hero .hero-meta {
        margin-top: 1.25rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        position: relative;
        z-index: 1;
      }
      .hero .hero-meta .pill {
        background: rgba(255, 255, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.25);
        backdrop-filter: blur(4px);
      }
      .pill {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.375rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
        line-height: 1;
      }

      /* Action bar */
      .action-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.5rem;
      }
      .action-bar h1 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text);
        letter-spacing: -0.02em;
      }
      .action-bar .actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      /* KPI strip */
      .kpi-strip {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
      }
      .kpi {
        background: var(--surface);
        border: 1px solid var(--border-light);
        border-radius: var(--radius);
        padding: 1.25rem 1.5rem;
        box-shadow: var(--shadow);
        position: relative;
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
      }
      .kpi:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
      .kpi::before {
        content: "";
        position: absolute;
        top: 0; left: 0;
        width: 4px; height: 100%;
      }
      .kpi.kpi-pending::before    { background: linear-gradient(180deg, #f59e0b, #fbbf24); }
      .kpi.kpi-scheduled::before  { background: linear-gradient(180deg, #3b82f6, #60a5fa); }
      .kpi.kpi-progress::before   { background: linear-gradient(180deg, #ec4899, #f472b6); }
      .kpi.kpi-completed::before  { background: linear-gradient(180deg, #10b981, #34d399); }
      .kpi.kpi-cancelled::before  { background: linear-gradient(180deg, #ef4444, #f87171); }
      .kpi.kpi-default::before   { background: linear-gradient(180deg, #2563eb, #6366f1); }
      .kpi .label {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted);
      }
      .kpi .value {
        font-size: 2rem;
        font-weight: 700;
        color: var(--text);
        line-height: 1.1;
        margin-top: 0.25rem;
      }
      .kpi .sub {
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-top: 0.25rem;
      }

      /* Filter chips */
      .chip-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1rem;
      }
      .chip {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.5rem 0.875rem;
        border-radius: 9999px;
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 600;
        transition: all 0.15s;
        cursor: pointer;
      }
      .chip:hover { color: var(--text); border-color: var(--text-muted); transform: translateY(-1px); }
      .chip.active {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
        box-shadow: 0 2px 4px rgba(37, 99, 235, 0.2);
      }
      .chip .count {
        background: rgba(0, 0, 0, 0.08);
        padding: 0.05rem 0.5rem;
        border-radius: 9999px;
        font-size: 0.7rem;
      }
      .chip.active .count { background: rgba(255, 255, 255, 0.25); }

      /* Modern table */
      .modern-table {
        background: var(--surface);
        border-radius: var(--radius);
        border: 1px solid var(--border-light);
        box-shadow: var(--shadow);
        overflow: hidden;
      }
      .modern-table table {
        margin: 0;
      }
      .modern-table thead th {
        background: linear-gradient(180deg, #f8fafc, #f1f5f9);
        border-bottom: 1px solid var(--border);
        padding: 0.875rem 1rem;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted);
      }
      .modern-table tbody tr {
        transition: background 0.15s;
      }
      .modern-table tbody tr:hover td {
        background: linear-gradient(90deg, var(--primary-light), transparent);
      }
      .modern-table tbody td {
        padding: 0.875rem 1rem;
        border-bottom: 1px solid var(--border-light);
        font-size: 0.875rem;
      }
      .modern-table tbody tr:last-child td {
        border-bottom: none;
      }
      .modern-table .job-number {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-weight: 600;
        color: var(--primary);
        font-size: 0.8rem;
      }
      .modern-table .customer {
        font-weight: 600;
        color: var(--text);
      }
      .modern-table .address {
        color: var(--text-muted);
        font-size: 0.8rem;
      }
      .modern-table .row-actions {
        display: flex;
        gap: 0.625rem;
        flex-wrap: wrap;
      }
      .modern-table .empty-row {
        text-align: center;
        padding: 3rem 1rem;
        color: var(--text-muted);
        font-style: italic;
      }

      /* Segmented tabs (replace .view-tabs look) */
      .segmented {
        display: inline-flex;
        gap: 0.25rem;
        background: var(--bg);
        padding: 0.25rem;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border-light);
      }
      .segmented a {
        padding: 0.4rem 0.875rem;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-muted);
        transition: all 0.15s;
      }
      .segmented a:hover { color: var(--text); }
      .segmented a.active {
        background: var(--surface);
        color: var(--primary);
        box-shadow: var(--shadow);
      }

      /* Info grid (job show) */
      .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
      }
      .info-tile {
        background: var(--surface);
        border: 1px solid var(--border-light);
        border-radius: var(--radius);
        padding: 1rem 1.25rem;
        box-shadow: var(--shadow);
        transition: transform 0.2s;
      }
      .info-tile:hover { transform: translateY(-2px); }
      .info-tile .label {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted);
        margin-bottom: 0.375rem;
      }
      .info-tile .value {
        font-size: 1rem;
        font-weight: 600;
        color: var(--text);
        word-break: break-word;
      }
      .info-tile .value.muted { color: var(--text-muted); font-weight: 400; }

      /* Timeline */
      .timeline {
        position: relative;
        padding-left: 1.5rem;
        margin: 0;
      }
      .timeline::before {
        content: "";
        position: absolute;
        left: 7px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: var(--border);
      }
      .timeline-item {
        position: relative;
        padding-bottom: 1.25rem;
      }
      .timeline-item::before {
        content: "";
        position: absolute;
        left: -1.5rem;
        top: 0.25rem;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: var(--primary);
        box-shadow: 0 0 0 3px var(--primary-light);
      }
      .timeline-item.success::before { background: #10b981; box-shadow: 0 0 0 3px #d1fae5; }
      .timeline-item.muted::before { background: var(--text-muted); box-shadow: 0 0 0 3px var(--border-light); }
      .timeline-item .title { font-weight: 600; }
      .timeline-item .meta { font-size: 0.8rem; color: var(--text-muted); }

      /* Section card title */
      .section-card {
        background: var(--surface);
        border-radius: var(--radius);
        border: 1px solid var(--border-light);
        box-shadow: var(--shadow);
        overflow: hidden;
        margin-bottom: 1.5rem;
      }
      .section-card > header {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--border);
        font-weight: 700;
        font-size: 1rem;
        color: var(--text);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }
      .section-card > .body {
        padding: 1.25rem 1.5rem;
      }

      /* Search bar */
      .search-bar {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 1.25rem;
        background: var(--surface);
        padding: 0.75rem 1rem;
        border-radius: var(--radius);
        border: 1px solid var(--border-light);
        box-shadow: var(--shadow);
      }
      .search-bar input[type="text"] {
        flex: 1;
        min-width: 220px;
        padding: 0.625rem 0.875rem;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        font-size: 0.9rem;
        background: var(--bg);
      }
      .search-bar input[type="text"]:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
      }
    </style>
    <%= stylesheet_link_tag "dashboard_branding", "data-turbo-track": "reload" %>
  </head>

  <body>
    <% if content_for?(:full_page) %>
      <%= yield :full_page %>
    <% else %>
      <div class="app-layout">
        <aside class="sidebar" id="sidebar">
          <div class="sidebar-header">
            <div class="sidebar-brand">
              <%= image_tag "INDUSTRO-PLUMBERS.png", alt: "Industro Plumbers" %>
              <span class="sidebar-brand-text">Industro Plumbers</span>
            </div>
            <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
              <span></span><span></span><span></span>
            </button>
          </div>
          <nav class="sidebar-nav">
            <ul>
              <li>
                <a href="<%= dashboard_path %>" class="<%= current_page?(dashboard_path) ? 'active' : '' %>" data-title="Dashboard">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                  <span>Dashboard</span>
                </a>
              </li>
              <li>
                <a href="<%= jobs_path %>" class="<%= current_page?(jobs_path) ? 'active' : '' %>" data-title="Jobs">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                  <span>Jobs</span>
                </a>
              </li>
              <% if current_user.admin? || current_user.super_admin? || current_user.reporter? %>
                <li>
                  <a href="<%= suppliers_path %>" class="<%= current_page?(suppliers_path) ? 'active' : '' %>" data-title="Suppliers">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                    <span>Suppliers</span>
                  </a>
                </li>
                <li>
                  <a href="<%= clients_path %>" class="<%= current_page?(clients_path) ? 'active' : '' %>" data-title="Clients">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    <span>Clients</span>
                  </a>
                </li>
                <li>
                  <a href="<%= inventory_items_path %>" class="<%= current_page?(inventory_items_path) ? 'active' : '' %>" data-title="Inventory">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                    <span>Inventory</span>
                  </a>
                </li>
              <% end %>
              <% if current_user.scheduler? %>
                <li>
                  <a href="<%= calendar_path %>" class="<%= current_page?(calendar_path) ? 'active' : '' %>" data-title="Calendar">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    <span>Calendar</span>
                  </a>
                </li>
              <% end %>
              <% if current_user.admin? || current_user.super_admin? %>
                <li>
                  <a href="<%= admin_root_path %>" class="<%= current_page?(admin_root_path) ? 'active' : '' %>" data-title="Admin">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                    <span>Admin</span>
                  </a>
                </li>
              <% end %>
            </ul>
          </nav>
          <div class="sidebar-footer">
            <div class="sidebar-user">
              <div class="sidebar-user-avatar"><%= current_user.name.to_s[0].upcase %></div>
              <div class="sidebar-user-meta">
                <div class="sidebar-user-name"><%= current_user.name %></div>
                <div class="sidebar-user-role"><%= current_user.role&.humanize || "User" %></div>
              </div>
            </div>
            <%= button_to destroy_user_session_path, method: :delete, class: "sidebar-logout" do %>
              <span>Logout</span>
            <% end %>
          </div>
        </aside>
        <main class="main-content">
          <div class="top-bar">
            <%= link_to root_path, class: "top-bar-brand" do %>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
              Industro Plumbers
            <% end %>
            <button class="top-bar-toggle" id="topBarToggle" aria-label="Toggle sidebar">
              <span></span><span></span><span></span>
            </button>
          </div>
          <% if notice %>
            <div class="notice"><%= notice %></div>
          <% end %>
          <% if alert %>
            <div class="alert"><%= alert %></div>
          <% end %>
          <%= yield %>
        </main>
      </div>
    <% end %>

    <%= javascript_importmap_tags %>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        var sidebar = document.getElementById('sidebar');
        var toggle = document.getElementById('sidebarToggle');
        var topToggle = document.getElementById('topBarToggle');
        
        function toggleSidebar() {
          if (window.innerWidth <= 768) {
            sidebar.classList.toggle('mobile-open');
          } else {
            sidebar.classList.toggle('collapsed');
          }
        }
        
        if (toggle) {
          toggle.addEventListener('click', toggleSidebar);
        }
        if (topToggle) {
          topToggle.addEventListener('click', toggleSidebar);
        }
        
        // Close mobile sidebar when clicking outside
        document.addEventListener('click', function(e) {
          if (window.innerWidth <= 768 && 
              sidebar.classList.contains('mobile-open') && 
              !sidebar.contains(e.target) && 
              e.target !== topToggle && 
              !topToggle.contains(e.target)) {
            sidebar.classList.remove('mobile-open');
          }
        });
      });
    </script>
  </body>
</html>