<!DOCTYPE html>
<html lang="en" data-theme="<%= current_theme %>">
  <head>
    <title><%= content_for(:title) || "Industro Plumbers - Estimate" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <style id="dm-vars">
      :root {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --primary-light: #eff6ff;
        --bg: #f8fafc;
        --surface: #ffffff;
        --text: #0f172a;
        --text-muted: #64748b;
        --border: #e2e8f0;
        --border-light: #f1f5f9;
      }
      [data-theme="dark"] {
        --primary: #60a5fa;
        --primary-dark: #3b82f6;
        --primary-light: #1e3a5f;
        --bg: #0a0a0e;
        --surface: #1a1a22;
        --text: #e5e7eb;
        --text-muted: #9ca3af;
        --border: #2d2d3a;
        --border-light: #2d2d3a;
      }
    </style>
  </head>
  <body>
    <button id="printBtn" class="no-print" style="position: fixed; top: 20px; right: 20px; padding: 10px 20px; background: var(--primary); color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 600; z-index: 1000;" onclick="window.print(); return false;">Print</button>
    <%= yield %>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        var printBtn = document.getElementById('printBtn');
        if (printBtn) {
          printBtn.addEventListener('click', function(e) { e.preventDefault(); window.print(); });
        }
      });
    </script>
    <style>
      @media print {
        .no-print { display: none !important; }
        body { margin: 0; padding: 0; }
        .quote-print-container { max-width: 100%; margin: 0; padding: 0; font-size: 14px; line-height: 1.3; }
        .quote-print-container .page { border-radius: 0; padding: 15px; box-shadow: none; border: none; }
        .logo { width: 150px; top: 8px; right: 15px; }
        .title { font-size: 20px; margin: 18px 0 18px 0; }
        .details-block { margin-bottom: 10px; }
        .detail-row { margin-bottom: 5px; line-height: 1.3; }
        .detail-label { width: 130px; font-size: 13px; }
        .detail-colon { margin-left: 8px; width: 12px; }
        .detail-value { font-size: 13px; }
        .subject-line { font-size: 20px; margin: 12px 0 4px 0; }
        .scope-block { margin-top: 15px; margin-bottom: 15px; }
        .scope-text { margin: 0 0 0.3rem 0; font-size: 13px; line-height: 1.4; }
        .line-items-container { margin: 8px 0; }
        .line-item-header { font-size: 11px; margin-bottom: 3px; }
        .line-item-row { padding: 2px 0; font-size: 13px; }
        .line-item-row .desc-col { font-size: 13px; }
        .totals-table { margin-top: 8px; font-size: 13px; }
        .totals-table td { padding: 3px; font-size: 13px; }
        .terms-block { margin-top: 18px; margin-bottom: 8px; }
        .terms-title { font-size: 13px; margin-bottom: 6px; }
        .terms-list li { margin-bottom: 3px; font-size: 12px; line-height: 1.3; }
        .closing-block { margin-top: 18px; }
        .closing-block p, .closing-block .signature-line { margin: 0 0 6px 0; font-size: 13px; }
        .footer { margin-top: 18px; padding-top: 8px; font-size: 11px; }
        .footer div { line-height: 1.3; }
        .page, .line-items-container, .terms-block, .closing-block, .totals-table { page-break-inside: avoid; }
      }
    </style>
  </body>
</html>
