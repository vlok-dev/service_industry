<tr class="item-row">
  <td style="padding: 8px; border-bottom: 1px solid var(--border);">
    <%= f.hidden_field :inventory_item_id, class: "inventory-id" %>
    <%= f.hidden_field :_destroy, class: "destroy-field" %>
    <%= f.text_field :code, placeholder: "Type to search codes...", class: "code-search", autocomplete: "off", style: "display:none;" %>
    <%= f.text_field :description, class: "item-description desc-input", placeholder: "Type description..." %>
    <ul class="code-results" style="display:none; max-height:160px; overflow-y:auto; margin:0; padding:0; border:1px solid var(--border-light); border-top:none; border-radius:4px; list-style:none; background:var(--bg);"></ul>
  </td>
  <td class="total-cell" style="padding: 8px; border-bottom: 1px solid var(--border);">
    <%= f.number_field :unit_price, min: 0, step: 0.01, class: "price", placeholder: "R 0.00" %>
  </td>
  <td style="padding: 8px; border-bottom: 1px solid var(--border);">
    <button type="button" class="remove-link">Remove</button>
  </td>
</tr>
